{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": ["pnpm-workspace.yaml"],
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "NODE_DISABLE_COMPILE_CACHE"],
  "concurrency": "50%",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "5GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!e2e/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/*.stories.ts",
        "!**/*.stories.tsx",
        "!vitest.config.ts",
        "!playwright.config.ts",
        "!README.md",
        "!CHANGELOG.md",
        "!LICENSE"
      ]
    },
    "build:types": {
      "outputs": ["dist/**/*.d.ts"]
    },
    "dev": {
      "dependsOn": ["^build", "@conciv/cli#build"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^build:types"],
      "outputs": [".tsbuildinfo", "**/.tsbuildinfo"]
    },
    "kit-runtime": {},
    "test": {
      "dependsOn": ["^build", "build", "^build:types", "^kit-runtime"],
      "env": ["CI", "GITHUB_ACTIONS"],
      "passThroughEnv": ["VITEST_MAX_FORKS", "VITEST_MAX_WORKERS"],
      "outputs": ["test-results.json", "coverage/coverage-summary.json"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "publint": {
      "dependsOn": ["build"]
    },
    "attw": {
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "@conciv/cli#build"],
      "cache": false,
      "env": ["CI", "GITHUB_ACTIONS"],
      "passThroughEnv": ["VITEST_MAX_FORKS", "VITEST_MAX_WORKERS"]
    }
  }
}
