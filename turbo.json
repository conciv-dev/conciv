{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "cacheDir": "../.turbo-cache",
  "globalDependencies": ["pnpm-workspace.yaml", ".oxlintrc.json"],
  "concurrency": "50%",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!tests/**",
        "!e2e/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/*.stories.ts",
        "!**/*.stories.tsx",
        "!vitest.config.ts",
        "!playwright.config.ts",
        "!README.md",
        "!CHANGELOG.md",
        "!LICENSE"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".tsbuildinfo", "**/.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "env": ["CI", "GITHUB_ACTIONS", "VITEST_MAX_FORKS", "VITEST_MAX_WORKERS"],
      "outputs": ["test-results.json", "coverage/coverage-summary.json"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "publint": {
      "dependsOn": ["build"]
    },
    "attw": {
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["CI", "GITHUB_ACTIONS", "CONCIV_E2E", "VITEST_MAX_FORKS", "VITEST_MAX_WORKERS"]
    }
  }
}
