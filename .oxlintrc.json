{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn"],
  "jsPlugins": [
    {
      "name": "unocss",
      "specifier": "@unocss/eslint-plugin"
    },
    {
      "name": "playwright",
      "specifier": "eslint-plugin-playwright"
    },
    {
      "name": "solid",
      "specifier": "eslint-plugin-solid"
    },
    {
      "name": "conciv",
      "specifier": "./packages/oxlint-plugin/src/plugin.js"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "conciv/banned-vocabulary": "error",
    "conciv/lucide-per-icon": "error",
    "conciv/no-comments": "error",
    "conciv/no-hand-made-temp-dir": "error",
    "conciv/no-inline-timeouts": "error",
    "conciv/no-locator-poll": "error",
    "conciv/no-mocks": "error",
    "conciv/no-of-suffix": "error",
    "conciv/no-signal-ref": "error",
    "conciv/no-teardown-hooks": "error",
    "conciv/playwright-test-in-e2e": "error",
    "conciv/solid-test-render": "error",
    "conciv/test-file-budget": "error",
    "conciv/tool-card-shell": "error",
    "conciv/user-event-only": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/require-module-specifiers": "off",
    "react/react-in-jsx-scope": "off",
    "react/no-unstable-nested-components": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/globals": "off",
    "react/static-components": "off",
    "react/hooks": "off",
    "react/capitalized-calls": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__conciv",
          "__CONCIV_API_BASE__",
          "__CONCIV_RENDER_TEST_CARD__",
          "__REACT_GRAB_DISABLED__",
          "__sdkStats",
          "__sdkReset",
          "__commandsCacheSet",
          "__client",
          "__server",
          "__render",
          "__serverRun",
          "__clientExecute",
          "__card",
          "__expand",
          "__ctx",
          "__scripted",
          "__turnMessages",
          "__TSR_ROUTER__",
          "__TSR_index",
          "_rbsplitInstance",
          "_debugHookTypes",
          "_debugStack",
          "_context",
          "_splat"
        ]
      }
    ],
    "unocss/order": "warn",
    "solid/jsx-no-duplicate-props": "error",
    "solid/jsx-no-undef": "error",
    "solid/jsx-uses-vars": "error",
    "solid/no-unknown-namespaces": "error",
    "solid/no-innerhtml": "warn",
    "solid/jsx-no-script-url": "error",
    "solid/components-return-once": "warn",
    "solid/no-destructure": "warn",
    "solid/prefer-for": "warn",
    "solid/reactivity": [
      "error",
      {
        "customReactiveFunctions": [
          "bindActiveSession",
          "keyArray",
          "makeBrowserRpcClient",
          "makeEventListener",
          "makeEventListenerStack",
          "makeTimer",
          "publishCardHeader",
          "registerLayer"
        ]
      }
    ],
    "solid/event-handlers": "error",
    "solid/imports": "error",
    "solid/style-prop": "warn",
    "solid/no-react-deps": "error",
    "solid/no-react-specific-props": "warn",
    "solid/self-closing-comp": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@hono/node-server",
            "importNames": ["serve", "createAdaptorServer", "getRequestListener"],
            "message": "Import serveHono from @conciv/serve, never @hono/node-server's serve \u2014 the wrapper bakes overrideGlobalObjects:false so a co-hosted engine never clobbers the host's global Response/Request (which breaks SSR realms, e.g. nitro rendering [object Response]). upgradeWebSocket may be imported directly."
          },
          {
            "name": "@tanstack/solid-query",
            "message": "Import TanStack Query from @conciv/client, never @tanstack/solid-query directly. @conciv/client bundles the one solid-query + query-core copy the widget and every plugin share, and that copy carries our TanStack/query#11230 patch; a direct import resolves a second, unpatched copy with its own QueryClient context and onlineManager."
          },
          {
            "name": "@tanstack/query-core",
            "message": "Import TanStack Query from @conciv/client, never @tanstack/query-core directly. @conciv/client bundles the one solid-query + query-core copy the widget and every plugin share, and that copy carries our TanStack/query#11230 patch; a direct import resolves a second, unpatched copy with its own QueryClient context and onlineManager."
          },
          {
            "name": "@orpc/tanstack-query",
            "message": "Import TanStack Query from @conciv/client, never @orpc/tanstack-query directly. @conciv/client bundles the one solid-query + query-core copy the widget and every plugin share, and that copy carries our TanStack/query#11230 patch; a direct import resolves a second, unpatched copy with its own QueryClient context and onlineManager."
          }
        ],
        "patterns": [
          {
            "group": ["@tanstack/ai", "@tanstack/ai-*", "@tanstack/ai/**", "@tanstack/ai-*/**"],
            "message": "Only packages/ai and packages/protocol may import @tanstack/ai*; use @conciv/protocol and the @conciv/ai entries."
          },
          {
            "group": ["@ark-ui", "@ark-ui/**"],
            "allowImportNames": ["useListCollection", "useFilter"],
            "message": "Import Ark UI components from @conciv/ui-kit-system, never @ark-ui directly \u2014 only ui-kit-system may wrap Ark UI. The headless hooks useListCollection / useFilter are the ONLY @ark-ui imports allowed elsewhere."
          }
        ]
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "overrides": [
    {
      "files": [
        "packages/plugins/page/src/rpc.ts",
        "packages/plugins/page/src/machine.ts",
        "packages/plugins/page/src/connection.ts",
        "packages/plugins/tanstack/src/rpc.ts"
      ],
      "rules": {
        "conciv/banned-vocabulary": "off"
      }
    },
    {
      "files": ["packages/plugin/src/**"],
      "rules": {
        "conciv/no-comments": ["error", {"keepDocComments": true}],
        "conciv/banned-vocabulary": "off"
      }
    },
    {
      "files": ["apps/site/**", "apps/conciv/**"],
      "rules": {
        "conciv/router-idioms": "error"
      }
    },
    {
      "files": ["packages/ui-kit-system/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/ui-kit-*/src/**", "apps/conciv/src/**"],
      "rules": {
        "conciv/no-delegated-focus": "error"
      }
    },
    {
      "files": ["packages/ai/**", "packages/protocol/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@hono/node-server",
                "importNames": ["serve", "createAdaptorServer", "getRequestListener"],
                "message": "Import serveHono from @conciv/serve, never @hono/node-server's serve \u2014 the wrapper bakes overrideGlobalObjects:false so a co-hosted engine never clobbers the host's global Response/Request (which breaks SSR realms, e.g. nitro rendering [object Response]). upgradeWebSocket may be imported directly."
              },
              {
                "name": "@tanstack/solid-query",
                "message": "Import TanStack Query from @conciv/client, never @tanstack/solid-query directly. @conciv/client bundles the one solid-query + query-core copy the widget and every plugin share, and that copy carries our TanStack/query#11230 patch; a direct import resolves a second, unpatched copy with its own QueryClient context and onlineManager."
              },
              {
                "name": "@tanstack/query-core",
                "message": "Import TanStack Query from @conciv/client, never @tanstack/query-core directly. @conciv/client bundles the one solid-query + query-core copy the widget and every plugin share, and that copy carries our TanStack/query#11230 patch; a direct import resolves a second, unpatched copy with its own QueryClient context and onlineManager."
              },
              {
                "name": "@orpc/tanstack-query",
                "message": "Import TanStack Query from @conciv/client, never @orpc/tanstack-query directly. @conciv/client bundles the one solid-query + query-core copy the widget and every plugin share, and that copy carries our TanStack/query#11230 patch; a direct import resolves a second, unpatched copy with its own QueryClient context and onlineManager."
              }
            ],
            "patterns": [
              {
                "group": ["@ark-ui", "@ark-ui/**"],
                "allowImportNames": ["useListCollection", "useFilter"],
                "message": "Import Ark UI components from @conciv/ui-kit-system, never @ark-ui directly \u2014 only ui-kit-system may wrap Ark UI. The headless hooks useListCollection / useFilter are the ONLY @ark-ui imports allowed elsewhere."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@hono/node-server",
                "importNames": ["serve", "createAdaptorServer", "getRequestListener"],
                "message": "Import serveHono from @conciv/serve, never @hono/node-server's serve \u2014 the wrapper bakes overrideGlobalObjects:false so a co-hosted engine never clobbers the host's global Response/Request (which breaks SSR realms, e.g. nitro rendering [object Response]). upgradeWebSocket may be imported directly."
              }
            ],
            "patterns": [
              {
                "group": ["@tanstack/ai", "@tanstack/ai-*", "@tanstack/ai/**", "@tanstack/ai-*/**"],
                "message": "Only packages/ai and packages/protocol may import @tanstack/ai*; use @conciv/protocol and the @conciv/ai entries."
              },
              {
                "group": ["@ark-ui", "@ark-ui/**"],
                "allowImportNames": ["useListCollection", "useFilter"],
                "message": "Import Ark UI components from @conciv/ui-kit-system, never @ark-ui directly \u2014 only ui-kit-system may wrap Ark UI. The headless hooks useListCollection / useFilter are the ONLY @ark-ui imports allowed elsewhere."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/plugin/**", "packages/plugins/*/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@hono/node-server",
                "importNames": ["serve", "createAdaptorServer", "getRequestListener"],
                "message": "Import serveHono from @conciv/serve, never @hono/node-server's serve \u2014 the wrapper bakes overrideGlobalObjects:false so a co-hosted engine never clobbers the host's global Response/Request (which breaks SSR realms, e.g. nitro rendering [object Response]). upgradeWebSocket may be imported directly."
              },
              {
                "name": "@tanstack/solid-query",
                "message": "A plugin imports useQuery, useMutation and useQueryClient from @conciv/client, never @tanstack/solid-query. The widget provides @conciv/client to every plugin bundle with its one patched Query copy (TanStack/query#11230) and query cache; no plugin imports a @tanstack/* Query package."
              },
              {
                "name": "@tanstack/query-core",
                "message": "A plugin imports useQuery, useMutation and useQueryClient from @conciv/client, never @tanstack/query-core. The widget provides @conciv/client to every plugin bundle with its one patched Query copy (TanStack/query#11230) and query cache; no plugin imports a @tanstack/* Query package."
              },
              {
                "name": "@orpc/tanstack-query",
                "message": "A plugin imports useQuery, useMutation and useQueryClient from @conciv/client, never @orpc/tanstack-query. Read engine methods with useQuery(() => ctx.client.rpc(Definition).method.queryOptions({input})); no plugin imports a @tanstack/* Query package."
              }
            ],
            "patterns": [
              {
                "group": ["@tanstack/ai", "@tanstack/ai-*", "@tanstack/ai/**", "@tanstack/ai-*/**"],
                "message": "Only packages/ai and packages/protocol may import @tanstack/ai*; use @conciv/protocol and the @conciv/ai entries."
              },
              {
                "group": ["@ark-ui", "@ark-ui/**"],
                "allowImportNames": ["useListCollection", "useFilter"],
                "message": "Import Ark UI components from @conciv/ui-kit-system, never @ark-ui directly \u2014 only ui-kit-system may wrap Ark UI. The headless hooks useListCollection / useFilter are the ONLY @ark-ui imports allowed elsewhere."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/plugins/*/src/**/*.tsx"],
      "rules": {
        "conciv/plugin-view-reads-through-query": "error"
      }
    },
    {
      "files": ["packages/serve/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "apps/site/**",
        "packages/react/**",
        "packages/preact/**",
        "packages/brand-react/**",
        "apps/examples/tanstack-start/src/**"
      ],
      "rules": {
        "solid/jsx-no-duplicate-props": "off",
        "solid/jsx-no-undef": "off",
        "solid/jsx-uses-vars": "off",
        "solid/no-unknown-namespaces": "off",
        "solid/no-innerhtml": "off",
        "solid/jsx-no-script-url": "off",
        "solid/components-return-once": "off",
        "solid/no-destructure": "off",
        "solid/prefer-for": "off",
        "solid/reactivity": "off",
        "solid/event-handlers": "off",
        "solid/imports": "off",
        "solid/style-prop": "off",
        "solid/no-react-deps": "off",
        "solid/no-react-specific-props": "off",
        "react/immutability": "error",
        "react/refs": "error",
        "react/purity": "error",
        "react/globals": "error",
        "react/static-components": "error",
        "react/hooks": "warn",
        "react/capitalized-calls": "warn",
        "solid/self-closing-comp": "off"
      }
    },
    {
      "files": ["packages/mascot-react/**"],
      "rules": {
        "solid/reactivity": "off",
        "solid/no-destructure": "off",
        "solid/no-react-specific-props": "off",
        "solid/style-prop": "off"
      }
    },
