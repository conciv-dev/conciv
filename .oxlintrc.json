{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn"],
  "jsPlugins": [
    {
      "name": "unocss",
      "specifier": "@unocss/eslint-plugin"
    },
    {
      "name": "playwright",
      "specifier": "eslint-plugin-playwright"
    },
    {
      "name": "solid",
      "specifier": "eslint-plugin-solid"
    },
    {
      "name": "conciv",
      "specifier": "./packages/oxlint-plugin/src/plugin.js"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "conciv/banned-vocabulary": "error",
    "conciv/lucide-per-icon": "error",
    "conciv/no-comments": "error",
    "conciv/no-locator-poll": "error",
    "conciv/no-signal-ref": "error",
    "conciv/solid-test-render": "error",
    "conciv/tool-card-shell": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/require-module-specifiers": "off",
    "react/react-in-jsx-scope": "off",
    "react/no-unstable-nested-components": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__conciv",
          "__CONCIV__",
          "__CONCIV_API_BASE__",
          "__CONCIV_PAGE_DRIVER__",
          "__CONCIV_REACT_BRIDGE__",
          "__CONCIV_RENDER_TEST_CARD__",
          "__REACT_GRAB_DISABLED__",
          "__sdkStats",
          "__sdkReset",
          "__commandsCacheSet",
          "__client",
          "__server",
          "__render",
          "__serverRun",
          "__clientExecute",
          "__card",
          "__expand",
          "__ctx",
          "__scripted",
          "__turnMessages",
          "__TSR_ROUTER__",
          "__TSR_index",
          "_rbsplitInstance",
          "_debugHookTypes",
          "_debugStack",
          "_context",
          "_splat"
        ]
      }
    ],
    "unocss/order": "warn",
    "solid/jsx-no-duplicate-props": "error",
    "solid/jsx-no-undef": "error",
    "solid/jsx-uses-vars": "error",
    "solid/no-unknown-namespaces": "error",
    "solid/no-innerhtml": "warn",
    "solid/jsx-no-script-url": "error",
    "solid/components-return-once": "warn",
    "solid/no-destructure": "warn",
    "solid/prefer-for": "warn",
    "solid/reactivity": [
      "error",
      {
        "customReactiveFunctions": [
          "bindActiveSession",
          "makeEventListener",
          "makeEventListenerStack",
          "makeTimer",
          "publishCardHeader",
          "registerLayer"
        ]
      }
    ],
    "solid/event-handlers": "error",
    "solid/imports": "error",
    "solid/style-prop": "warn",
    "solid/no-react-deps": "error",
    "solid/no-react-specific-props": "warn",
    "solid/self-closing-comp": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@hono/node-server",
            "importNames": ["serve", "createAdaptorServer", "getRequestListener"],
            "message": "Import serveHono from @conciv/serve, never @hono/node-server's serve \u2014 the wrapper bakes overrideGlobalObjects:false so a co-hosted engine never clobbers the host's global Response/Request (which breaks SSR realms, e.g. nitro rendering [object Response]). upgradeWebSocket may be imported directly."
          }
        ],
        "patterns": [
          {
            "group": ["@ark-ui", "@ark-ui/**"],
            "allowImportNames": ["useListCollection", "useFilter"],
            "message": "Import Ark UI components from @conciv/ui-kit-system, never @ark-ui directly \u2014 only ui-kit-system may wrap Ark UI. The headless hooks useListCollection / useFilter are the ONLY @ark-ui imports allowed elsewhere."
          }
        ]
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "overrides": [
    {
      "files": ["apps/site/**", "apps/conciv/**"],
      "rules": {
        "conciv/router-idioms": "error"
      }
    },
    {
      "files": ["packages/ui-kit-system/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/serve/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/site/**", "packages/react/**", "packages/preact/**", "packages/brand/src/react/**"],
      "rules": {
        "solid/jsx-no-duplicate-props": "off",
        "solid/jsx-no-undef": "off",
        "solid/jsx-uses-vars": "off",
        "solid/no-unknown-namespaces": "off",
        "solid/no-innerhtml": "off",
        "solid/jsx-no-script-url": "off",
        "solid/components-return-once": "off",
        "solid/no-destructure": "off",
        "solid/prefer-for": "off",
        "solid/reactivity": "off",
        "solid/event-handlers": "off",
        "solid/imports": "off",
        "solid/style-prop": "off",
        "solid/no-react-deps": "off",
        "solid/no-react-specific-props": "off",
        "solid/self-closing-comp": "off"
      }
    },
    {
      "files": ["packages/mascot/src/react/**", "packages/mascot/tests/browser/react-*"],
      "rules": {
        "solid/reactivity": "off",
        "solid/no-destructure": "off",
        "solid/no-react-specific-props": "off",
        "solid/style-prop": "off"
      }
    },
    {
      "files": [
        "packages/extensions/terminal/src/server/**",
        "packages/extensions/terminal/test/**",
        "packages/ui-kit-terminal/**"
      ],
      "rules": {
        "no-control-regex": "off"
      }
    },
    {
      "files": ["**/*.worker.ts", "apps/site/src/components/landing/demo/use-local-model.ts"],
      "rules": {
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["packages/solid-streamdown/**", "packages/page/**"],
      "rules": {
        "unocss/order": "off"
      }
    },
    {
      "files": ["apps/**"],
      "rules": {
        "unocss/order": "off"
      }
    },
    {
      "files": ["packages/extensions/**/test/**", "packages/extension-testkit/**/test/**"],
      "rules": {
        "playwright/no-raw-locators": "error",
        "playwright/no-eval": "error",
        "playwright/no-element-handle": "error",
        "playwright/prefer-native-locators": "error",
        "playwright/prefer-web-first-assertions": "error"
      }
    },
    {
      "files": ["packages/embed/tests/**", "packages/extension-testkit/src/**"],
      "rules": {
        "playwright/prefer-web-first-assertions": "error"
      }
    },
    {
      "files": ["packages/extensions/**/test/fixtures/**"],
      "rules": {
        "playwright/no-raw-locators": "off",
        "playwright/no-eval": "off",
        "playwright/no-element-handle": "off",
        "playwright/prefer-native-locators": "off"
      }
    },
    {
      "files": ["packages/core/src/**"],
      "rules": {
        "conciv/core-purity": "error"
      }
    },
    {
      "files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "conciv/banned-vocabulary": "off"
      }
    },
    {
      "files": ["packages/harness-testkit/src/**", "packages/extension-testkit/src/**"],
      "rules": {
        "conciv/no-predicate-waits": "error"
      }
    },
    {
      "files": ["**/until.ts", "**/run-stream.ts"],
      "rules": {
        "conciv/no-predicate-waits": "off"
      }
    },
    {
      "files": ["packages/cli/test/**"],
      "rules": {
        "conciv/no-timers-in-tests": "error"
      }
    },
    {
      "files": ["packages/cli/test/support/cli-app.ts"],
      "rules": {
        "conciv/no-timers-in-tests": "off"
      }
    },
    {
      "files": ["packages/ui-kit-system/test/dialog-harness.tsx"],
      "rules": {
        "conciv/solid-test-render": "off"
      }
    },
    {
      "files": ["packages/extensions/terminal/test/reload-replay.browser.test.tsx"],
      "rules": {
        "conciv/solid-test-render": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "build",
    "node_modules",
    ".turbo",
    ".conciv",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "**/test-results",
    "packages/plugin/test/fixtures/**",
    "packages/extensions/tanstack/test/fixtures/**",
    "packages/cli/test/fixtures/**",
    "packages/oxlint-plugin/test/fixtures/**",
    "packages/oxlint-plugin/fixtures/**",
    "e2e/*/src",
    "e2e/*/app"
  ]
}
