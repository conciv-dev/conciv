{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^build:types", "@conciv/simulation#build"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "build", "@conciv/cli#build"]
    }
  }
}
