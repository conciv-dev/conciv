{
  "name": "site",
  "version": "0.0.19",
  "private": true,
  "homepage": "https://conciv.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "apps/site"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "node scripts/copy-widget-bundle.mjs && node scripts/build-source-manifest.mjs && vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "gen:snippets": "node --experimental-strip-types scripts/highlight-snippets.ts"
  },
  "dependencies": {
    "@conciv/brand": "workspace:*",
    "@conciv/embed": "workspace:*",
    "@conciv/extension-terminal": "workspace:*",
    "@conciv/extension-try-it": "workspace:*",
    "@conciv/it": "workspace:*",
    "@conciv/mascot": "workspace:*",
    "@conciv/protocol": "workspace:*",
    "@fontsource-variable/geist": "^5.2.9",
    "@gsap/react": "^2.1.2",
    "@huggingface/transformers": "^4.2.0",
    "@shikijs/magic-move": "^4.3.0",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.10.2",
    "fumadocs-mdx": "^15.0.12",
    "fumadocs-ui": "^16.10.2",
    "gsap": "catalog:",
    "lenis": "^1.3.25",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "motion": "catalog:",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "takumi-js": "^2.7.3",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.4",
    "@conciv/browser-fixture": "workspace:*",
    "@conciv/core": "workspace:*",
    "@conciv/extension-compiler": "workspace:*",
    "@conciv/harness-testkit": "workspace:*",
    "@conciv/try": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "shiki": "catalog:",
    "tailwindcss": "catalog:",
    "twoslash": "^0.3.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.112.0"
  }
}
