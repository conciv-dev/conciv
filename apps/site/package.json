{
  "name": "site",
  "version": "0.0.22",
  "private": true,
  "homepage": "https://conciv.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "apps/site"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "node scripts/build-reference.mjs && vite dev --port 3001",
    "build": "node scripts/build-source-manifest.mjs && node scripts/build-reference.mjs && vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "node scripts/build-reference.mjs && fumadocs-mdx && tsc --noEmit",
    "test": "vitest run"
  },
