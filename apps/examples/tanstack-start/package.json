{
  "name": "tanstack-start-example",
  "version": "0.0.22",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "plugin:build": "vite build --config conciv/plugins/deploy/vite.config.ts",
    "plugin:watch": "vite build --watch --config conciv/plugins/deploy/vite.config.ts",
    "dev": "pnpm run plugin:build && pnpm run \"/^(plugin:watch|dev:vite)$/\"",
    "dev:vite": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "pnpm run plugin:build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p conciv/plugins/deploy/tsconfig.json --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@conciv/cli": "workspace:*",
    "@conciv/embed": "workspace:*",
    "@conciv/extension-recorder": "workspace:*",
    "@conciv/it": "workspace:*",
    "@conciv/plugin-tanstack": "workspace:*",
    "@conciv/plugin-test-runner": "workspace:*",
    "@conciv/plugin-whiteboard": "workspace:*",
    "@conciv/protocol": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/plugin": "workspace:*",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "nitro": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
