{
  "name": "@conciv/app",
  "version": "0.0.20",
  "private": true,
  "description": "The conciv app: a TanStack Solid Router UI over the @conciv/contract rpc surface. Inlined by @conciv/embed; runs standalone against a core dev server.",
  "type": "module",
  "exports": {
    "./router": "./src/router.tsx",
    "./settings": "./src/data/settings.ts",
    "./shadow": "./src/lib/shadow.ts",
    "./api-base": "./src/lib/api-base.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:perf": "vitest run --mode perf --project browser"
  },
  "dependencies": {
    "@ark-ui/solid": "catalog:",
    "@conciv/ai": "workspace:^",
    "@conciv/client": "workspace:^",
    "@conciv/contract": "workspace:^",
    "@conciv/core": "workspace:^",
    "@conciv/extension": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/mascot": "workspace:^",
    "@conciv/page": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/solid-streamdown": "workspace:^",
    "@conciv/tools": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-chat-tools": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@conciv/ui-kit-tap": "workspace:^",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/mutation-observer": "^1.2.4",
    "@tanstack/hotkeys": "^0.18.0",
    "@tanstack/pacer": "catalog:",
    "@tanstack/solid-hotkeys": "^0.17.0",
    "@tanstack/solid-query": "catalog:",
    "@tanstack/solid-router": "catalog:",
    "lucide-solid": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/browser-fixture": "workspace:*",
    "@conciv/extension-page": "workspace:^",
    "@conciv/extension-terminal": "workspace:^",
    "@conciv/extension-testkit": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/storage-history": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@unocss/postcss": "catalog:",
    "@unocss/reset": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
