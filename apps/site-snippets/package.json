{
  "name": "site-snippets",
  "version": "0.0.22",
  "private": true,
  "homepage": "https://conciv.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "apps/site-snippets"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/framework-snippets.ts",
    "./generated": "./src/framework-snippets.gen.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "gen:snippets": "node --experimental-strip-types src/scripts/highlight-snippets.ts"
  },
  "dependencies": {
    "@shikijs/magic-move": "catalog:"
  },
  "devDependencies": {
    "@conciv/it": "workspace:*",
    "@conciv/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "shiki": "catalog:",
    "twoslash": "^0.3.9",
    "typescript": "catalog:ts6",
    "vite": "catalog:"
  }
}
