{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "gen-migrations": {
      "inputs": ["drizzle/**", "scripts/gen-migrations.ts"],
      "outputs": ["src/migrations.gen.ts"]
    },
    "build": {
      "dependsOn": ["^build", "gen-migrations"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "gen-migrations"]
    }
  }
}
