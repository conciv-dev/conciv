{
  "name": "@conciv/ui-kit-chat-tools",
  "version": "0.0.20",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The conciv tool-card vocabulary: concrete tool-call cards (Bash, Edit, Read, Search, Todo, apply_patch, page, ui, …) built on @conciv/ui-kit-chat's tool-building primitives + @conciv/ui-kit-system. ui-kit-chat stays tool-agnostic; this package knows the tools.",
  "keywords": [
    "ai-chat",
    "conciv",
    "solid-js",
    "ui-kit"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/ui-kit-chat-tools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/ai": "workspace:^",
    "@conciv/extension-page": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "es-toolkit": "catalog:",
    "lucide-solid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/tools": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "@unocss/postcss": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
