    "./plugin/servers": "./src/plugin/servers.tsx",
    "./plugin/host": "./src/plugin/host.tsx",
    "./plugin/render": "./src/plugin/render.tsx",
    "./lib/media-query": "./src/lib/media-query.ts",
    "./lib/view-tab-ids": "./src/lib/view-tab-ids.ts",
    "./persistence/persist": "./src/persistence/persist.ts",
    "./plugin/dialog-stack": "./src/plugin/dialog-stack.tsx",
    "./plugin/panel-keys": "./src/plugin/panel-keys.ts",
    "./plugin/settings-pages": "./src/plugin/settings-pages.ts",
    "./persistence/storage": "./src/persistence/storage.ts",
    "./plugin/located": "./src/plugin/located.ts",
    "./plugin/panels": "./src/plugin/panels.tsx",
    "./plugin/stores": "./src/plugin/stores.ts",
    "./plugin/ui": "./src/plugin/ui.tsx",
    "./plugin/bundle-source": "./src/plugin/bundle-source.ts",
    "./plugin/plugins": "./src/plugin/plugins.tsx",
    "./plugin/startup": "./src/plugin/startup.ts",
    "./plugin/hmr": "./src/plugin/hmr.tsx",
    "./plugin/panel-trigger": "./src/plugin/panel-trigger.tsx",
    "./opaque": "./src/opaque.ts",
    "./lib/style-sheet": "./src/lib/style-sheet.ts",
    "./plugin/installed": "./src/plugin/installed.ts",
    "./plugin/settings-layout": "./src/plugin/settings-layout.tsx"
