  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
