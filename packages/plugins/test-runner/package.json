{
  "name": "@conciv/plugin-test-runner",
  "version": "0.0.22",
  "description": "The conciv test-runner plugin: runs the project's tests (vitest, playwright), streams each run live in the Tests tab and shows the finished run as a card in the thread.",
  "keywords": [
    "conciv",
    "conciv-plugin",
    "playwright",
    "plugin",
    "test-runner",
    "vitest"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/test-runner"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/test-runner.d.ts",
      "import": "./dist/test-runner.js"
    },
    "./server": {
      "types": "./dist/test-runner.d.ts",
      "import": "./dist/test-runner.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "import": "./dist/test-utils.js"
    },
    "./plugin-experimental": {
      "types": "./dist/plugin-experimental.d.cts",
      "default": "./dist/plugin-experimental.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/protocol": "workspace:^",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/backend-test-utils": "workspace:*",
    "@conciv/client": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@conciv/harness": "workspace:*",
    "@conciv/unplugin": "workspace:*",
    "@internal/frontend-app-api": "workspace:*",
    "@internal/frontend-test-utils": "workspace:*",
    "@internal/test-utils": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "solid-js": "catalog:"
  }
}
