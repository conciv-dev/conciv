{
  "name": "@conciv/plugin-try-it",
  "version": "0.0.24",
  "description": "The conciv try-it plugin: offers the widget a local conciv engine that a visitor starts with npx, and covers the panel with the connect steps until that engine answers.",
  "keywords": [
    "conciv",
    "conciv-plugin",
    "connect",
    "plugin"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/try-it"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin-experimental.d.ts",
      "import": "./dist/plugin-experimental.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/errors": "workspace:*",
    "@conciv/types": "workspace:^",
    "@solid-primitives/autofocus": "catalog:",
    "effect": "catalog:",
    "evlog": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-test-utils": "workspace:*",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@conciv/harness": "workspace:*",
    "@effect/vitest": "catalog:",
    "@internal/frontend-app-api": "workspace:*",
    "@internal/frontend-test-utils": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unplugin-solid": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/frontend-plugin-api": "workspace:^",
    "solid-js": "^1.9.13"
  }
}
