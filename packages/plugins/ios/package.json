{
  "name": "@conciv/plugin-ios",
  "version": "0.0.25",
  "description": "The conciv iOS plugin: the engine part builds, runs, screenshots and reads the logs of a native iOS app on the simulator through xcodebuild, swiftc and simctl; the browser part is the WKWebView bridge the widget's native page speaks to the app.",
  "keywords": [
    "bridge",
    "conciv",
    "conciv-plugin",
    "ios",
    "plugin",
    "simulator",
    "webview"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/ios"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/ios.d.ts",
      "import": "./dist/ios.js"
    },
    "./server": {
      "types": "./dist/ios.d.ts",
      "import": "./dist/ios.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./builtins": {
      "types": "./dist/builtins.d.ts",
      "import": "./dist/builtins.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:css": "node scripts/build-css.ts",
    "build": "pnpm run build:css && tsdown",
    "gen:fixtures": "node test/fixtures/bridge/gen.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/grab": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/types": "workspace:^",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "evlog": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/backend-test-utils": "workspace:*",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@effect/vitest": "catalog:",
    "@internal/engine-kit": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unplugin-solid": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "solid-js": "^1.9.13"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "conciv": {
    "testBudget": 5
  }
}
