{
  "name": "@internal/plugin-whiteboard",
  "version": "0.0.22",
  "private": true,
  "description": "The conciv whiteboard plugin: a canvas the user and the agent share, with source-anchored comments and pins, on the plugin storage the host keeps.",
  "keywords": [
    "canvas",
    "conciv",
    "conciv-plugin",
    "plugin",
    "whiteboard"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/whiteboard"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/whiteboard.ts",
      "import": "./dist/whiteboard.js"
    },
    "./server": {
      "types": "./src/whiteboard.ts",
      "import": "./dist/whiteboard.js"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./dist/rpc.js"
    },
    "./plugin-experimental": {
      "types": "./src/plugin-experimental.tsx",
      "default": "./dist/plugin-experimental.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/protocol": "workspace:^",
    "@takumi-rs/core": "catalog:",
    "@takumi-rs/helpers": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "evlog": "catalog:",
    "oxc-parser": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/backend-test-utils": "workspace:*",
    "@conciv/client": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@conciv/harness": "workspace:*",
    "@conciv/plugin-page": "workspace:*",
    "@conciv/unplugin": "workspace:*",
    "@excalidraw/excalidraw": "catalog:",
    "@excalidraw/mermaid-to-excalidraw": "catalog:",
    "@internal/frontend-app-api": "workspace:*",
    "@internal/frontend-test-utils": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@solid-primitives/event-listener": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/solid-db": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^"
  }
}
