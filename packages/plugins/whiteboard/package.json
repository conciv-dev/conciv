{
  "name": "@conciv/plugin-whiteboard",
  "version": "0.0.22",
  "private": true,
  "description": "The conciv whiteboard plugin: a canvas the user and the agent share, with source-anchored comments and pins, on the plugin storage the host keeps.",
  "keywords": [
    "canvas",
    "conciv",
    "conciv-plugin",
    "plugin",
    "whiteboard"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/whiteboard"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./plugin-experimental": "./dist/plugin-experimental.cjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints plugin-experimental"
  },
  "dependencies": {
    "@conciv/protocol": "workspace:^",
    "@takumi-rs/core": "catalog:",
    "@takumi-rs/helpers": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "oxc-parser": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/browser-fixture": "workspace:*",
    "@conciv/embed": "workspace:*",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/plugin": "workspace:^",
    "@conciv/plugin-testkit": "workspace:^",
    "@conciv/tsconfig": "workspace:*",
    "@conciv/ui-kit-tap": "workspace:*",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@excalidraw/excalidraw": "catalog:",
    "@excalidraw/mermaid-to-excalidraw": "catalog:",
    "@playwright/test": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@tanstack/solid-db": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/plugin": "workspace:^"
  }
}
