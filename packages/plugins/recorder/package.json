{
  "name": "@conciv/plugin-recorder",
  "version": "0.0.22",
  "description": "The conciv recorder plugin: a sliding window of the page's rrweb recording on the engine, agent tools returning a distilled action log plus keyframes, and the recorder RPC.",
  "keywords": [
    "conciv",
    "conciv-plugin",
    "plugin",
    "recorder",
    "replay",
    "rrweb"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/recorder"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/recorder.d.ts",
      "import": "./dist/recorder.js"
    },
    "./server": {
      "types": "./dist/recorder.d.ts",
      "import": "./dist/recorder.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./plugin-experimental": {
      "types": "./dist/plugin-experimental.d.cts",
      "default": "./dist/plugin-experimental.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/protocol": "workspace:^",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "playwright-core": "catalog:",
    "rrweb": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/client": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@conciv/plugin-testkit": "workspace:*",
    "@internal/frontend-app-api": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@rrweb/rrweb-plugin-console-record": "catalog:",
    "@rrweb/types": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "rrweb-player": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^"
  }
}
