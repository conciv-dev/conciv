{
  "name": "@conciv/plugin-page",
  "version": "0.0.24",
  "description": "conciv's page plugin: the engine part (the connection to the page, its tools, skill and RPC contract) and the browser part the widget runs (DOM helpers, page operations, cards).",
  "keywords": [
    "conciv",
    "page",
    "plugin"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/page"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./engine-builtins": {
      "types": "./dist/engine-builtins.d.ts",
      "import": "./dist/engine-builtins.js"
    },
    "./builtins": {
      "types": "./dist/builtins.d.ts",
      "import": "./dist/builtins.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "import": "./dist/test-utils.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/client": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/types": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@jridgewell/trace-mapping": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/map": "catalog:",
    "@tanstack/hotkeys": "catalog:",
    "@tanstack/solid-hotkeys": "catalog:",
    "@tanstack/solid-pacer": "catalog:",
    "@zumer/snapdom": "catalog:",
    "ai-motion": "catalog:",
    "bippy": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "js-beautify": "^2.0.3",
    "lucide-solid": "catalog:",
    "react-grab": "catalog:",
    "rrweb-snapshot": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-test-utils": "workspace:*",
    "@effect/vitest": "catalog:",
    "@internal/frontend-app-api": "workspace:*",
    "@internal/frontend-test-utils": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-document": "catalog:",
    "@tiptap/extension-paragraph": "catalog:",
    "@tiptap/extension-text": "catalog:",
    "@tiptap/pm": "catalog:",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  },
  "conciv": {
    "builtin": true
  }
}
