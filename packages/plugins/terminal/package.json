{
  "name": "@internal/plugin-terminal",
  "version": "0.0.22",
  "private": true,
  "description": "The conciv terminal plugin: the browser part of the session's CLI terminal, a pinned Terminal tab in the session's pane over the engine's persistent pty.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/terminal"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./builtins": {
      "types": "./src/builtins.ts",
      "import": "./dist/builtins.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/client": "workspace:^",
    "@conciv/types": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:*",
    "@conciv/ui-kit-terminal": "workspace:^",
    "@orpc/client": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "effect": "catalog:",
    "lucide-solid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-test-utils": "workspace:*",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@conciv/plugin-page": "workspace:*",
    "@internal/frontend-test-utils": "workspace:*",
    "@internal/test-utils": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/frontend-plugin-api": "workspace:^",
    "solid-js": "catalog:"
  },
  "conciv": {
    "builtin": true
  }
}
