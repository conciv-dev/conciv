{
  "name": "@conciv/plugin-terminal",
  "version": "0.0.22",
  "private": true,
  "description": "The conciv terminal plugin: the browser part of the session's CLI terminal, a pinned Terminal tab in the session's pane over core's persistent pty.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugins/terminal"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@conciv/client": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:*",
    "@conciv/ui-kit-terminal": "workspace:^",
    "@orpc/client": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "effect": "catalog:",
    "lucide-solid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/plugin": "workspace:^",
    "@conciv/tsconfig": "workspace:*",
    "@conciv/uno-preset": "workspace:*",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "peerDependencies": {
    "@conciv/plugin": "workspace:^",
    "solid-js": "catalog:"
  }
}
