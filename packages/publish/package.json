{
  "name": "@conciv/publish",
  "version": "0.0.20",
  "private": true,
  "description": "Internal release tooling for the aidx monorepo: normalize package metadata, version, and publish via changesets. citty command tree.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/publish"
  },
  "bin": {
    "conciv-publish": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@changesets/parse": "^1.0.0",
    "citty": "catalog:",
    "execa": "^10.2.1",
    "js-yaml": "5.5.0",
    "minimatch": "10.2.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
