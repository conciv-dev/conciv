  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@changesets/parse": "^0.4.3",
    "citty": "catalog:",
    "execa": "^9.5.0",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
