{
  "name": "@internal/publish",
  "version": "0.0.22",
  "private": true,
  "description": "Internal release tooling for the aidx monorepo: normalize package metadata, version, and publish via changesets. citty command tree.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/publish"
  },
  "bin": {
    "conciv-ci-shards": "./src/ci-shards.ts",
    "conciv-publish": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p turbo/generators/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@changesets/parse": "^1.0.0",
    "citty": "catalog:",
    "es-toolkit": "catalog:",
    "execa": "^10.2.1",
    "js-yaml": "catalog:",
    "minimatch": "10.2.6",
    "oxc-parser": "catalog:",
    "vite-plugin-solid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
