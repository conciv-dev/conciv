{
  "name": "@conciv/preact",
  "version": "0.0.24",
  "description": "Preact component for the conciv widget: render <ConcivWidget /> to mount the conciv dev agent in any Preact app.",
  "keywords": [
    "ai",
    "chat",
    "conciv",
    "preact",
    "widget"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/preact"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js",
      "default": "./dist/preact.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/app": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "evlog": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-test-utils": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "preact": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "preact": ">=10"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
