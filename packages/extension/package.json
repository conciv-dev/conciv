{
  "name": "@conciv/extension",
  "version": "0.0.21",
  "description": "The conciv extension authoring contract: defineExtension/defineTool plus the SolidJS runtime context and typed useSlot/useContext hooks.",
  "keywords": [
    "conciv",
    "extension",
    "plugins"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/extension"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./tool": {
      "types": "./dist/define-tool.d.ts",
      "import": "./dist/define-tool.js"
    },
    "./registry": {
      "types": "./dist/tool-registry.d.ts",
      "import": "./dist/tool-registry.js"
    },
    "./rpc-mount": {
      "types": "./dist/rpc-mount.d.ts",
      "import": "./dist/rpc-mount.js"
    },
    "./devframe-host": {
      "types": "./dist/devframe-host.d.ts",
      "import": "./dist/devframe-host.js"
    },
    "./devframe-connection": {
      "types": "./dist/devframe-connection.d.ts",
      "import": "./dist/devframe-connection.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/contract": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@devframes/agentic": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@tanstack/pacer": "catalog:",
    "devframe": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-solid": "^2.0.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
