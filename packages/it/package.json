{
  "name": "@conciv/it",
  "version": "0.0.22",
  "description": "Conceive it. Claude Code, living inside your running app. Plugin for vite, webpack, rspack, rollup, esbuild, nextjs.",
  "keywords": [
    "ai",
    "conciv",
    "dev-agent",
    "embeddable",
    "vite-plugin"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/it"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./plugin/vite": {
      "types": "./dist/plugin/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./plugin/webpack": {
      "types": "./dist/plugin/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./plugin/rspack": {
      "types": "./dist/plugin/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./plugin/rollup": {
      "types": "./dist/plugin/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./plugin/esbuild": {
      "types": "./dist/plugin/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./plugin/nextjs": {
      "types": "./dist/plugin/nextjs.d.ts",
      "edge-light": "./dist/nextjs-edge.js",
      "import": "./dist/nextjs.js",
      "default": "./dist/nextjs.js"
    },
    "./plugin/nextjs/widget": {
      "types": "./dist/plugin/nextjs-widget.d.ts",
      "import": "./dist/nextjs-widget.js",
      "default": "./dist/nextjs-widget.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --ignore-pattern 'test/fixtures/design/host/**' --ignore-pattern 'test/fixtures/design/provenance/**'",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/embed": "workspace:^",
    "@conciv/extension-compiler": "workspace:^",
    "@conciv/extension-design": "workspace:^",
    "@conciv/extension-ios": "workspace:^",
    "@conciv/extension-recorder": "workspace:^",
    "@conciv/extension-terminal": "workspace:^",
    "@conciv/extension-test-runner": "workspace:^",
    "@conciv/extension-whiteboard": "workspace:^",
    "@conciv/plugin": "workspace:^"
  },
  "devDependencies": {
    "@conciv/contract": "workspace:^",
    "@conciv/extension-testkit": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/tsconfig": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "culori": "catalog:",
    "pixelmatch": "catalog:",
    "playwright": "catalog:",
    "pngjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "^15.3.0 || ^16.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
