{
  "name": "@conciv/client",
  "version": "0.0.23",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). conciv client data layer: typed oRPC access, TanStack Query option factories, and the useChat connection bridge. Zero UI.",
  "keywords": [
    "client",
    "conciv",
    "orpc",
    "tanstack-intent"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/errors": "workspace:*",
    "@conciv/protocol": "workspace:^",
    "@conciv/types": "workspace:^",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/effect": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/scheduled": "catalog:",
    "@standard-server/peer": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/ai-solid": "catalog:",
    "@tanstack/pacer": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@tanstack/solid-query": "catalog:",
    "defu": "catalog:",
    "effect": "catalog:",
    "evlog": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
