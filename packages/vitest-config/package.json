{
  "name": "@internal/vitest-config",
  "version": "0.0.22",
  "private": true,
  "description": "Internal shared vitest config for the conciv monorepo: the test projects, the isolated home and the CI reporters.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/vitest-config"
  },
  "type": "module",
  "exports": {
    ".": "./src/reporters.ts",
    "./test-layout": "./src/test-layout.ts",
    "./temp-dir": "./src/temp-dir.ts",
    "./isolated-env": "./src/isolated-env.ts",
    "./conciv-test": "./src/conciv-test.ts",
    "./browser-project": "./src/browser-project.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "evlog": "catalog:",
    "playwright": "catalog:",
    "unocss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "peerDependenciesMeta": {
    "@solidjs/testing-library": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-solid": {
      "optional": true
    }
  }
}
