{
  "name": "@internal/vitest-config",
  "version": "0.0.22",
  "private": true,
  "description": "Internal shared config helpers for the aidx monorepo: CI reporters, the CI shard planner, and the shared Solid library build config.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/vitest-config"
  },
  "bin": {
    "conciv-ci-shards": "./src/ci-shards.ts",
    "conciv-test": "./src/run-tests.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/reporters.ts",
    "./new-layer": "./src/new-layer.ts",
    "./pack": "./src/pack.ts",
    "./temp-dir": "./src/temp-dir.ts",
    "./vite-lib": "./src/vite-lib.ts",
    "./run-tests": "./src/run-tests.ts",
    "./isolated-env": "./src/isolated-env.ts",
    "./test-config": "./src/test-config.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "node src/run-tests.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vite-plugin-solid": {
      "optional": true
    }
  }
}
