{
  "name": "@conciv/vitest-config",
  "version": "0.0.22",
  "private": true,
  "description": "Internal shared config helpers for the aidx monorepo: CI reporters, the conciv-ci-summary job-summary generator, and the shared Solid library build config.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/vitest-config"
  },
  "bin": {
    "conciv-ci-shards": "./src/ci-shards.ts",
    "conciv-ci-summary": "./src/ci-summary.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/reporters.ts",
    "./dom": "./src/dom.ts",
    "./expected-log": "./src/expected-log.ts",
    "./new-layer": "./src/new-layer.ts",
    "./pack": "./src/pack.ts",
    "./playwright": "./src/playwright.ts",
    "./solid-cleanup": "./src/solid-cleanup-setup.ts",
    "./temp-dir": "./src/temp-dir.ts",
    "./vite-lib": "./src/vite-lib.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@conciv/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@solidjs/testing-library": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-solid": {
      "optional": true
    }
  }
}
