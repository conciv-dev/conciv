{
  "name": "@conciv/types",
  "version": "0.0.22",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). Wire types shared by the conciv vite-plugin and widget.",
  "keywords": [
    "ag-ui",
    "conciv",
    "protocol",
    "types"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./chat-types": {
      "types": "./dist/chat-types.d.ts",
      "import": "./dist/chat-types.js"
    },
    "./chat-busy": {
      "types": "./dist/chat-busy.d.ts",
      "import": "./dist/chat-busy.js"
    },
    "./chat-message-types": {
      "types": "./dist/chat-message-types.d.ts",
      "import": "./dist/chat-message-types.js"
    },
    "./chat-event-types": {
      "types": "./dist/chat-event-types.d.ts",
      "import": "./dist/chat-event-types.js"
    },
    "./chat-tool-types": {
      "types": "./dist/chat-tool-types.d.ts",
      "import": "./dist/chat-tool-types.js"
    },
    "./usage-types": {
      "types": "./dist/usage-types.d.ts",
      "import": "./dist/usage-types.js"
    },
    "./ui-types": {
      "types": "./dist/ui-types.d.ts",
      "import": "./dist/ui-types.js"
    },
    "./harness-types": {
      "types": "./dist/harness-types.d.ts",
      "import": "./dist/harness-types.js"
    },
    "./rpc-types": {
      "types": "./dist/rpc-types.d.ts",
      "import": "./dist/rpc-types.js"
    },
    "./terminal-types": {
      "types": "./dist/terminal-types.d.ts",
      "import": "./dist/terminal-types.js"
    },
    "./bundler-types": {
      "types": "./dist/bundler-types.d.ts",
      "import": "./dist/bundler-types.js"
    },
    "./config-types": {
      "types": "./dist/config-types.d.ts",
      "import": "./dist/config-types.js"
    },
    "./tool-view-types": {
      "types": "./dist/tool-view-types.d.ts",
      "import": "./dist/tool-view-types.js"
    },
    "./connect-ports": {
      "types": "./dist/connect-ports.d.ts",
      "import": "./dist/connect-ports.js"
    },
    "./state-types": {
      "types": "./dist/state-types.d.ts",
      "import": "./dist/state-types.js"
    },
    "./migration-lock": {
      "types": "./dist/migration-lock.d.ts",
      "import": "./dist/migration-lock.js"
    },
    "./engine-trust": {
      "types": "./dist/engine-trust.d.ts",
      "import": "./dist/engine-trust.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus.d.ts",
      "import": "./dist/event-bus.js"
    },
    "./tool-call-types": {
      "types": "./dist/tool-call-types.d.ts",
      "import": "./dist/tool-call-types.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./secret-key": {
      "types": "./dist/secret-key.d.ts",
      "import": "./dist/secret-key.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/errors": "workspace:*",
    "@tanstack/ai": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
