{
  "name": "@conciv/serve",
  "version": "0.0.19",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). conciv's @hono/node-server serve() wrapper that bakes overrideGlobalObjects:false so a co-hosted engine never clobbers the host's global Response/Request.",
  "keywords": [
    "conciv",
    "hono",
    "server"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/serve"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/protocol": "workspace:*",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
