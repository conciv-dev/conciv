{
  "name": "@internal/frontend-defaults",
  "version": "0.0.22",
  "private": true,
  "description": "The conciv browser shell with no plugin in it: router, pane, composer, sessions and settings over the @conciv/protocol rpc surface. Inlined by @conciv/app.",
  "type": "module",
  "exports": {
    ".": "./src/frontend-defaults.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:perf": "vitest run --project perf"
  },
  "dependencies": {
    "@ark-ui/solid": "catalog:",
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/client": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/mascot": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-streamdown": "workspace:^",
    "@conciv/storage-history": "workspace:^",
    "@conciv/types": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-chat-tools": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@conciv/ui-kit-tap": "workspace:^",
    "@internal/frontend-app-api": "workspace:*",
    "@orpc/client": "catalog:",
    "@solid-primitives/active-element": "^2.1.6",
    "@solid-primitives/date": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/keyed": "catalog:",
    "@solid-primitives/mutation-observer": "^1.2.4",
    "@solid-primitives/resize-observer": "catalog:",
    "@solid-primitives/storage": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@tanstack/hotkeys": "catalog:",
    "@tanstack/pacer": "catalog:",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-hotkeys": "catalog:",
    "@tanstack/solid-pacer": "catalog:",
    "@tanstack/solid-router": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "fuzzysort": "catalog:",
    "lucide-solid": "catalog:",
    "semver": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "@unocss/reset": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
