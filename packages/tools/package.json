{
  "name": "@conciv/tools",
  "version": "0.0.20",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). conciv agent tools as @tanstack/ai toolDefinition().server() functions: ui, page, test.",
  "keywords": [
    "ai-tools",
    "conciv",
    "tool-definitions"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/tools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./defs": {
      "types": "./dist/defs.d.ts",
      "import": "./dist/defs.js"
    },
    "./builtins": {
      "types": "./dist/builtins.d.ts",
      "import": "./dist/builtins.js"
    },
    "./cards": {
      "browser": {
        "types": "./dist/cards.d.ts",
        "default": "./dist/cards.js"
      },
      "import": {
        "types": "./dist/cards.d.ts",
        "default": "./dist/cards.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.cards.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cards.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/extension-page": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "lucide-solid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
