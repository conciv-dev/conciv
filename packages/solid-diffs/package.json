{
  "name": "@conciv/solid-diffs",
  "version": "0.0.20",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). SolidJS wrappers around @pierre/diffs: thin Solid components over the framework-agnostic FileDiff / File web-component renderers (Shiki-highlighted diffs + code), reusable across the conciv UI.",
  "keywords": [
    "code-diff",
    "conciv",
    "diff",
    "solid-js"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/solid-diffs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.2",
    "@tanstack/solid-pacer": "0.22.0"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
