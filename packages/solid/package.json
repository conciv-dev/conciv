{
  "name": "@conciv/solid",
  "version": "0.0.25",
  "description": "Solid component for the conciv widget: render <ConcivWidget /> to mount the conciv dev agent in any Solid app.",
  "keywords": [
    "ai",
    "chat",
    "conciv",
    "solid",
    "widget"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js",
      "default": "./dist/solid.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/app": "workspace:^",
    "evlog": "catalog:"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
