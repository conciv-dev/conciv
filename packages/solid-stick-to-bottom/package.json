{
  "name": "@conciv/solid-stick-to-bottom",
  "version": "0.0.19",
  "description": "SolidJS port of use-stick-to-bottom: a stick-to-bottom scroll behavior for chat/log viewports (spring-follow scroll, escape on up-scroll, silent re-lock on shrink, selection guard).",
  "keywords": [
    "conciv",
    "scroll",
    "solid-js",
    "stick-to-bottom"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/solid-stick-to-bottom"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/stick-to-bottom.d.ts",
      "import": "./dist/stick-to-bottom.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/timer": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
