{
  "name": "@conciv/ui-kit-tap",
  "version": "0.0.19",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). TipTap-based rich-text primitives for conciv (SolidJS, shadow-DOM-safe): a mention composer built on @tiptap/core and the shared ui-kit-system tokens. Each primitive is viewable in Storybook.",
  "keywords": [
    "conciv",
    "prosemirror",
    "rich-text",
    "solid-js",
    "tiptap",
    "ui-kit"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/ui-kit-tap"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/ui-kit-system": "workspace:*",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-document": "catalog:",
    "@tiptap/extension-hard-break": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-paragraph": "catalog:",
    "@tiptap/extension-text": "catalog:",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "catalog:",
    "@tiptap/suggestion": "^3.32.0"
  },
  "devDependencies": {
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "@unocss/postcss": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
