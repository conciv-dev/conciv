{
  "name": "@internal/plugin",
  "version": "0.0.22",
  "private": true,
  "description": "Private to conciv, as Backstage's @internal/frontend: the opaque definitions conciv's SDK, app and own plugins share. Inlined into its users' builds, never published.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugin-internal"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@conciv/plugin": "workspace:^",
    "@internal/opaque": "workspace:*"
  },
  "devDependencies": {
    "@conciv/tsconfig": "workspace:*",
    "solid-js": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
