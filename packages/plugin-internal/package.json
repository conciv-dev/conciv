{
  "name": "@conciv/plugin-internal",
  "version": "0.0.22",
  "private": true,
  "description": "Private to conciv's first-party plugins: the conciv opaque types and the private contracts the app answers, such as the conciv UI.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugin-internal"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@conciv/opaque": "workspace:*",
    "@conciv/plugin": "workspace:^",
    "@conciv/ui-kit-tap": "workspace:^"
  },
  "devDependencies": {
    "@conciv/tsconfig": "workspace:*",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
