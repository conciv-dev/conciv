{
  "name": "@conciv/storage-history",
  "version": "0.0.24",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). Web-Storage-persisted @tanstack/history for the conciv widget: entries/index round-trip with corrupted-storage fallback.",
  "keywords": [
    "conciv",
    "history",
    "router"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/storage-history"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/storage-history.d.ts",
      "import": "./dist/storage-history.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@tanstack/history": "^1.162.5"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@internal/vite-config": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
