{
  "name": "@conciv/extension-testkit",
  "version": "0.0.19",
  "private": true,
  "description": "Dev-only test harness: getExtensionTestApi(extension) mounts any conciv extension in a real browser against a real spawned server through its real contract.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/extension-testkit"
  },
  "type": "module",
  "exports": {
    ".": "./src/get-extension-test-api.ts",
    "./card-harness": "./src/card-harness.tsx",
    "./connect-handshake": "./src/connect-handshake.ts",
    "./core-kit": "./src/core-kit.ts",
    "./framework-fake": "./src/framework-fake.ts",
    "./host/grab": "./src/host/grab.ts",
    "./widget-suite": "./src/widget-suite.ts",
    "./test-host": "./src/test-host-config.ts",
    "./page-plane": "./src/page-plane.ts",
    "./listen-local": "./src/listen-local.ts",
    "./serve-host": "./src/serve-host.ts",
    "./navigation-state": "./src/navigation-state.ts",
    "./rpc-frames": "./src/rpc-frames.ts",
    "./rpc-counts": "./src/rpc-counts.ts",
    "./rpc-wire": "./src/rpc-wire.ts",
    "./rpc-fault": "./src/rpc-fault.ts"
  },
  "scripts": {
    "build": "vite build -c vite.test-host.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vite build -c vite.ws-probe.config.ts && vitest run && playwright test"
  },
  "dependencies": {
    "@conciv/browser-fixture": "workspace:*",
    "@conciv/contract": "workspace:^",
    "@conciv/core": "workspace:^",
    "@conciv/extension": "workspace:^",
    "@conciv/extension-compiler": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@conciv/uno-preset": "workspace:^",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/standard-server": "catalog:",
    "@orpc/standard-server-peer": "catalog:",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.8",
    "p-timeout": "^7.0.1",
    "playwright": "^1.61.1",
    "solid-js": "^1.9.13",
    "unocss": "^66.7.2",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "^22.19.21",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
