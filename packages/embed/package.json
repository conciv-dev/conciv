{
  "name": "@conciv/embed",
  "version": "0.0.20",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). Also powers the @conciv/react and @conciv/preact wrapper components. The conciv embed bundle: mounts the conciv router app into a Shadow DOM on the host page and starts the page plane. Inlines the private conciv app and @conciv/page; externalizes shared Solid/Ark/@conciv packages.",
  "keywords": [
    "ai",
    "chat",
    "conciv",
    "embed",
    "solid-js"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/embed"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js",
      "default": "./dist/mount.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.global.config.ts && vite build --config vite.native.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vite build --config vite.handle.config.ts && vitest run && playwright test",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@ark-ui/solid": "catalog:",
    "@conciv/ai": "workspace:^",
    "@conciv/client": "workspace:^",
    "@conciv/contract": "workspace:^",
    "@conciv/extension": "workspace:^",
    "@conciv/extension-ios": "workspace:^",
    "@conciv/extension-page": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/mascot": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/solid-streamdown": "workspace:^",
    "@conciv/storage-history": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-chat-tools": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@conciv/ui-kit-tap": "workspace:^",
    "@tanstack/pacer": "catalog:",
    "@tanstack/solid-router": "catalog:",
    "bippy": "catalog:",
    "react-grab": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@conciv/app": "workspace:*",
    "@conciv/extension-recorder": "workspace:^",
    "@conciv/extension-terminal": "workspace:^",
    "@conciv/extension-testkit": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/page": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@orpc/server": "catalog:",
    "@playwright/test": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@types/node": "catalog:",
    "@unocss/postcss": "catalog:",
    "@unocss/reset": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
