{
  "name": "@conciv/embed",
  "version": "0.0.22",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). Also powers the @conciv/react, @conciv/preact and @conciv/solid wrapper components. The conciv embed bundle: mounts the conciv router app into a Shadow DOM on the host page. Inlines the private conciv app and the page plugin's browser part (@conciv/plugin-page/client and /renderer); externalizes shared Solid/Ark/@conciv packages.",
  "keywords": [
    "ai",
    "chat",
    "conciv",
    "embed",
    "solid-js"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/embed"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js",
      "default": "./dist/mount.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "node node_modules/@conciv/plugin-testkit/bin/conciv-test.js"
  },
  "dependencies": {
    "@ark-ui/solid": "catalog:",
    "@conciv/client": "workspace:^",
    "@conciv/contract": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/mascot": "workspace:^",
    "@conciv/plugin": "workspace:^",
    "@conciv/plugin-ios": "workspace:^",
    "@conciv/plugin-page": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/solid-streamdown": "workspace:^",
    "@conciv/storage-history": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-chat-tools": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@conciv/ui-kit-tap": "workspace:^",
    "@conciv/ui-kit-terminal": "workspace:^",
    "@solid-primitives/event-listener": "catalog:",
    "@tanstack/solid-router": "catalog:",
    "bippy": "catalog:",
    "effect": "catalog:",
    "react-grab": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@conciv/app": "workspace:*",
    "@conciv/harness-testkit": "workspace:*",
    "@conciv/plugin-testkit": "workspace:*",
    "@conciv/tsconfig": "workspace:*",
    "@conciv/uno-preset": "workspace:*",
    "@types/node": "catalog:",
    "@unocss/reset": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
