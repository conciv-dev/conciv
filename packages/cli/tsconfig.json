{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/fixtures/**"]
}
