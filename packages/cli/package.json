{
  "name": "@conciv/cli",
  "version": "0.0.23",
  "description": "The conciv front door: `npx @conciv/cli@latest init` sets your project up end to end, and `conciv tools` gives your coding agent the live page, React tree, and dev server.",
  "keywords": [
    "ai-agent",
    "cli",
    "conciv"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/cli"
  },
  "bin": {
    "conciv": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./bin": "./dist/bin.js",
    "./commands": "./dist/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.51.0"
  },
  "devDependencies": {
    "@bomb.sh/router": "catalog:",
    "@clack/prompts": "catalog:",
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/backend-test-utils": "workspace:*",
    "@conciv/client": "workspace:^",
    "@conciv/harness": "workspace:^",
    "@conciv/home": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/types": "workspace:^",
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@orpc/client": "catalog:",
    "@tanstack/ai-mcp": "catalog:",
    "@types/node": "catalog:",
    "diff": "^9.0.0",
    "es-toolkit": "catalog:",
    "evlog": "catalog:",
    "nypm": "^0.6.12",
    "picocolors": "^1.1.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
