{
  "name": "@conciv/react",
  "version": "0.0.24",
  "description": "React component for the conciv widget: render <ConcivWidget /> to mount the conciv dev agent in any React app.",
  "keywords": [
    "ai",
    "chat",
    "conciv",
    "react",
    "widget"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "sync-injected": "true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/app": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "evlog": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@conciv/backend-test-utils": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/vite-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
