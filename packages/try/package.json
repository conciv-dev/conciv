{
  "name": "@conciv/try",
  "version": "0.0.22",
  "description": "Try conciv live on conciv.dev with the agent already on your machine: `npx @conciv/try --token <token>` boots a token-gated, loopback-only conciv core powered by your own agent.",
  "keywords": [
    "ai-agent",
    "cli",
    "conciv"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/try"
  },
  "bin": {
    "conciv-try": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && chmod +x dist/bin.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@conciv/backend": "workspace:^",
    "@conciv/harness": "workspace:^",
    "@conciv/types": "workspace:^",
    "citty": "catalog:",
    "effect": "catalog:",
    "evlog": "catalog:"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
