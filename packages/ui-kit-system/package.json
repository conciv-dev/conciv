{
  "name": "@conciv/ui-kit-system",
  "version": "0.0.24",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The conciv design system: SolidJS primitives (Button + Ark-UI-based Collapsible, HoverCard, ScrollArea, Combobox, Progress) styled with the shared UnoCSS preset, so every surface looks and behaves identically. Each component is viewable in Storybook.",
  "keywords": [
    "ark-ui",
    "conciv",
    "design-system",
    "solid-js",
    "ui-kit"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/ui-kit-system"
  },
  "files": [
    "dist",
    "docs",
    "src/host.css",
    "src/tokens.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/ui-kit-system.d.ts",
      "import": "./dist/ui-kit-system.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./host.css": "./src/host.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:tokens": "node src/scripts/gen-tokens.ts",
    "gen:check": "node src/scripts/check-tokens.ts",
    "build": "pnpm gen:tokens && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints tokens.css host.css"
  },
  "dependencies": {
    "@ark-ui/solid": "catalog:",
    "@solid-primitives/clipboard": "^1.6.6",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/keyed": "catalog:",
    "@solid-primitives/map": "catalog:",
    "@solid-primitives/media": "catalog:",
    "@solid-primitives/resize-observer": "catalog:",
    "@solid-primitives/timer": "catalog:",
    "@tanstack/solid-hotkeys": "catalog:",
    "@tanstack/solid-virtual": "catalog:",
    "@zag-js/json-tree-utils": "^1.47.0",
    "class-variance-authority": "catalog:",
    "lucide-solid": "catalog:"
  },
  "devDependencies": {
    "@conciv/errors": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@types/node": "catalog:",
    "@unocss/postcss": "catalog:",
    "postcss": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
