{
  "name": "@conciv/ui-kit-system",
  "version": "0.0.19",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The conciv design system: SolidJS primitives (Button + Ark-UI-based Collapsible, HoverCard, ScrollArea, Combobox, Progress) styled with the shared UnoCSS preset, so every surface looks and behaves identically. Each component is viewable in Storybook.",
  "keywords": [
    "ark-ui",
    "conciv",
    "design-system",
    "solid-js",
    "ui-kit"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/ui-kit-system"
  },
  "files": [
    "dist",
    "docs",
    "src/tokens.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.ts",
    "gen:check": "node scripts/check-tokens.ts",
    "build": "pnpm gen:tokens && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints tokens.css"
  },
  "dependencies": {
    "@ark-ui/solid": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "class-variance-authority": "catalog:",
    "lucide-solid": "catalog:"
  },
  "devDependencies": {
    "@conciv/browser-fixture": "workspace:*",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "@unocss/postcss": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
