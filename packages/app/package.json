{
  "name": "@conciv/app",
  "version": "0.0.24",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). Also powers the @conciv/react, @conciv/preact and @conciv/solid wrapper components. The conciv widget bundle: mounts the conciv shell (@internal/frontend-defaults) into a Shadow DOM on the host page. Inlines the private shell and the built-in plugins' browser parts (page, terminal); externalizes shared Solid/Ark/@conciv packages.",
  "keywords": [
    "ai",
    "chat",
    "conciv",
    "embed",
    "solid-js"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/app"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js",
      "default": "./dist/mount.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@ark-ui/solid": "catalog:",
    "@conciv/backend-plugin-api": "workspace:^",
    "@conciv/client": "workspace:^",
    "@conciv/errors": "workspace:^",
    "@conciv/frontend-plugin-api": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/mascot": "workspace:^",
    "@conciv/plugin-ios": "workspace:^",
    "@conciv/plugin-page": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/solid-streamdown": "workspace:^",
    "@conciv/storage-history": "workspace:^",
    "@conciv/types": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-chat-tools": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@conciv/ui-kit-tap": "workspace:^",
    "@conciv/ui-kit-terminal": "workspace:^",
    "@solid-primitives/event-listener": "catalog:",
    "@tanstack/solid-router": "catalog:",
    "effect": "catalog:",
    "evlog": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@internal/frontend-app-api": "workspace:*",
    "@internal/frontend-defaults": "workspace:*",
    "@internal/plugin-terminal": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/uno-preset": "workspace:*",
    "@internal/vite-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@unocss/reset": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
