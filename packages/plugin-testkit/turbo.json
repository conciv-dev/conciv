{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@conciv/mascot#build",
        "@conciv/plugin-internal#build",
        "@conciv/plugin-tanstack#build",
        "@conciv/plugin-terminal#build",
        "@conciv/ui-kit-chat-tools#build",
        "@conciv/ui-kit-tap#build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "@conciv/mascot#build",
        "@conciv/plugin-internal#build",
        "@conciv/plugin-tanstack#build",
        "@conciv/plugin-terminal#build",
        "@conciv/ui-kit-chat-tools#build",
        "@conciv/ui-kit-tap#build"
      ],
      "outputs": [".tsbuildinfo", "**/.tsbuildinfo"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/apps/conciv/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/apps/conciv/uno.config.ts",
        "$TURBO_ROOT$/packages/ui-kit-chat/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/ui-kit-chat-tools/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/ui-kit-system/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/ui-kit-terminal/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/ui-kit-tap/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/tools/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/core/src/cards/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/plugins/page/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/plugins/recorder/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/plugins/tanstack/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/plugins/terminal/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/plugins/test-runner/src/**/*.{ts,tsx}",
        "$TURBO_ROOT$/packages/plugins/whiteboard/src/**/*.{ts,tsx}"
      ]
    }
  }
}
