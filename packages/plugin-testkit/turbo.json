{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "build:types": {
      "dependsOn": ["build"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "typecheck": {
      "dependsOn": [
        "@conciv/simulation#build",
        "@conciv/client#build",
        "@conciv/backend-defaults#build",
        "@conciv/protocol#build",
        "@conciv/backend#build",
        "@conciv/grab#build",
        "@conciv/mascot#build",
        "@conciv/backend-plugin-api#build",
        "@conciv/frontend-plugin-api#build",
        "@internal/plugin-terminal#build",
        "@conciv/types#build",
        "@conciv/solid-streamdown#build",
        "@conciv/storage-history#build",
        "@conciv/ui-kit-chat#build",
        "@conciv/ui-kit-chat-tools#build",
        "@conciv/ui-kit-system#build",
        "@conciv/ui-kit-tap#build"
      ]
    },
    "kit-runtime": {
      "dependsOn": [
        "@conciv/backend#build",
        "@internal/frontend-defaults#kit-runtime",
        "@conciv/simulation#kit-runtime"
      ]
    },
    "test": {
      "dependsOn": ["^build", "build", "build:types", "@conciv/simulation#build", "kit-runtime"]
    },
    "publint": {
      "dependsOn": ["build", "build:types"]
    },
    "attw": {
      "dependsOn": ["build", "build:types"]
    }
  }
}
