{
  "name": "@conciv/plugin-testkit",
  "version": "0.0.22",
  "description": "Boots the real engine and widget with the fake model chat for widget and plugin tests.",
  "keywords": [
    "conciv",
    "playwright",
    "plugin",
    "testing",
    "testkit",
    "vitest"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugin-testkit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/contract": "workspace:^",
    "@conciv/core": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/plugin": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@orpc/client": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/app": "workspace:*",
    "@conciv/tsconfig": "workspace:*",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "playwright": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/app": "workspace:*",
    "playwright": "^1.64.1",
    "vitest": "^5.1.0"
  }
}
