{
  "name": "@conciv/extension-browser-driver",
  "version": "0.0.21",
  "private": true,
  "description": "Internal conciv.dev built-in extension: answers the page capture verbs from the server by driving the browser over a protocol (CDP today), so a capture is a true browser clip.",
  "keywords": [
    "browser",
    "cdp",
    "conciv",
    "extension"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/extension-page": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "puppeteer-core": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
