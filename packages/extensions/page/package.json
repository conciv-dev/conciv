{
  "name": "@conciv/extension-page",
  "version": "0.0.22",
  "description": "Internal conciv.dev built-in extension: the grab attachment's engine handler, the old page tool definitions and the snapdom capture plugins the design extension uses.",
  "keywords": [
    "browser",
    "conciv",
    "dom",
    "extension",
    "page"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/extensions/page"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json",
    "./defs": {
      "types": "./dist/shared/defs.d.ts",
      "import": "./dist/shared/defs.js"
    },
    "./capture-plugins": {
      "types": "./dist/client/capture-plugins.d.ts",
      "import": "./dist/client/capture-plugins.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@zumer/snapdom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
