{
  "extends": "@conciv/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "outDir": ".tsc-refs",
    "noEmit": false,
    "incremental": true,
    "tsBuildInfoFile": ".tsc-refs/tsconfig.refs.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "vitest.config.ts"],
  "exclude": ["test/fixtures/react-app.tsx", "test/page.browser.test.tsx"]
}
