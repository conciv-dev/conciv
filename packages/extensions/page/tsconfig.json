{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "rootDir": ".",
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
