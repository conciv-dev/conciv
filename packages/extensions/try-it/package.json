{
  "name": "@conciv/extension-try-it",
  "version": "0.0.19",
  "private": true,
  "description": "Internal conciv.dev demo extension: renders the guided connect steps inside the widget panel and probes for a locally-connected agent core. Not published.",
  "keywords": [
    "conciv",
    "connect",
    "extension"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && vite build -c vite.test-host.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/timer": "catalog:",
    "lucide-solid": "catalog:"
  },
  "devDependencies": {
    "@conciv/extension-testkit": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
