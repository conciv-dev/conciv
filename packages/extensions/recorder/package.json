{
  "name": "@conciv/extension-recorder",
  "version": "0.0.20",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The recorder built-in extension: rrweb session recording of the host page with a server-side sliding window, agent tools returning a distilled action log plus keyframes, and a replay panel.",
  "keywords": [
    "conciv",
    "extension",
    "recorder",
    "replay",
    "rrweb"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/extensions/recorder"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/client.d.ts",
        "conciv-source": "./src/client.tsx",
        "default": "./dist/client.js"
      },
      "import": {
        "types": "./dist/server.d.ts",
        "conciv-source": "./src/server.ts",
        "default": "./dist/server.js"
      }
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "conciv-source": "./src/client.tsx",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "conciv-source": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.build.json && vite build -c vite.test-host.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:*",
    "@conciv/ui-kit-system": "workspace:^",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@rrweb/rrweb-plugin-console-record": "^2.1.0",
    "@rrweb/types": "^2.1.0",
    "@solid-primitives/timer": "catalog:",
    "@tanstack/solid-query": "catalog:",
    "lucide-solid": "catalog:",
    "playwright-core": "^1.64.1",
    "rrweb": "^2.1.0",
    "rrweb-player": "2.0.0-alpha.20",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/core": "workspace:^",
    "@conciv/extension-testkit": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/serve": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/ai-mcp": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
