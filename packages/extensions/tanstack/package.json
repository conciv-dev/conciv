{
  "name": "@conciv/extension-tanstack",
  "version": "0.0.20",
  "description": "Internal conciv.dev extension: framework-inspection adapter for TanStack Router/Start apps, surfacing router state, loader data, and query cache to the widget.",
  "keywords": [
    "conciv",
    "extension",
    "inspection",
    "router",
    "tanstack"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/extensions/tanstack"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/client.d.ts",
        "conciv-source": "./src/client.tsx",
        "default": "./dist/client.js"
      },
      "import": {
        "types": "./dist/server.d.ts",
        "conciv-source": "./src/server.ts",
        "default": "./dist/server.js"
      }
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "conciv-source": "./src/client.tsx",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "conciv-source": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.build.json && vite build -c vite.test-host.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/host/tsconfig.json --noEmit && tsc -p test/host/conciv/tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/page": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:*",
    "@conciv/ui-kit-chat-tools": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "lucide-solid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/browser-fixture": "workspace:*",
    "@conciv/core": "workspace:^",
    "@conciv/embed": "workspace:^",
    "@conciv/extension-compiler": "workspace:^",
    "@conciv/extension-testkit": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/plugin": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@solid-primitives/event-listener": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.170.0",
    "solid-js": "^1.9.13"
  }
}
