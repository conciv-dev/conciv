{
  "name": "@conciv/extension-test-runner",
  "version": "0.0.19",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The test-runner built-in extension: runner-agnostic adapters (vitest today; jest/node-test/playwright via the ChildRunnerSpec seam) exposed through the @conciv/extension contract: server routes, a test tool, and the live results card.",
  "keywords": [
    "conciv",
    "extension",
    "jest",
    "playwright",
    "test-runner",
    "vitest"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/extensions/test-runner"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vitest": {
      "types": "./dist/runners/vitest/adapter.d.ts",
      "import": "./dist/runners/vitest/adapter.js"
    },
    "./jest": {
      "types": "./dist/runners/jest.d.ts",
      "import": "./dist/runners/jest.js"
    },
    "./node-test": {
      "types": "./dist/runners/node-test.d.ts",
      "import": "./dist/runners/node-test.js"
    },
    "./playwright": {
      "types": "./dist/runners/playwright/adapter.d.ts",
      "import": "./dist/runners/playwright/adapter.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@orpc/server": "catalog:",
    "es-toolkit": "catalog:",
    "lucide-solid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/core": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
