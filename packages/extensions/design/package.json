{
  "name": "@conciv/extension-design",
  "version": "0.0.23",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The design built-in extension: holds a target image per route and width, captures the live page at that width and returns ranked component deltas with style provenance.",
  "keywords": [
    "conciv",
    "design",
    "extension",
    "visual-diff"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/extensions/design"
  },
  "files": [
    "dist",
    "models"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && vite build --config vite.xray.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "dev:xray": "vite --config vite.xray.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@blazediff/core": "catalog:",
    "@bramus/specificity": "catalog:",
    "@conciv/extension": "workspace:^",
    "@conciv/extension-page": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@orpc/server": "catalog:",
    "@zumer/snapdom": "catalog:",
    "culori": "catalog:",
    "es-toolkit": "catalog:",
    "hono": "catalog:",
    "onnxruntime-web": "catalog:",
    "oxc-parser": "catalog:",
    "pixelmatch": "catalog:",
    "pngjs": "catalog:",
    "postcss": "catalog:",
    "ppu-ocv": "catalog:",
    "ppu-paddle-ocr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/contract": "workspace:^",
    "@conciv/extension-compiler": "workspace:^",
    "@conciv/extension-testkit": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/it": "workspace:^",
    "@conciv/tsconfig": "workspace:*",
    "@conciv/ui-kit-system": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@iconify-json/ph": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/timer": "catalog:",
    "@tanstack/solid-router": "catalog:",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@unocss/reset": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
