{
  "name": "@conciv/extension-whiteboard",
  "version": "0.0.20",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The whiteboard built-in extension: an Excalidraw canvas the user and the AI share over the dev app, with source-anchored comments and pins, running on a local drizzle/libSQL db with an SSE-fed TanStack DB client on the @conciv/extension contract.",
  "keywords": [
    "ai",
    "canvas",
    "conciv",
    "excalidraw",
    "extension",
    "whiteboard"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/extensions/whiteboard"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.build.json && vite build -c vite.test-host.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/extension": "workspace:^",
    "@conciv/grab": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@conciv/ui-kit-chat-tools": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@conciv/ui-kit-tap": "workspace:^",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@libsql/client": "^0.17.4",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@takumi-rs/core": "^1.8.7",
    "@takumi-rs/helpers": "^1.8.7",
    "@tanstack/pacer": "catalog:",
    "@tanstack/solid-db": "^0.2.28",
    "cytoscape": "3.34.0",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "catalog:",
    "lucide-solid": "catalog:",
    "oxc-parser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/extension-testkit": "workspace:^",
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.10",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
