{
  "extends": "./tsconfig.react.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "incremental": false
  },
  "include": ["src/react/**/*.ts", "src/react/**/*.tsx"]
}
