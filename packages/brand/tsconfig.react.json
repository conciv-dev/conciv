{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo.react",
    "rootDir": ".",
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src/react/**/*.ts",
    "src/react/**/*.tsx",
    "tests/browser/lockup-dom.ts",
    "tests/browser/react-lockup.browser.test.tsx",
    "tests/browser/react-lockup-reduced-motion.browser.test.tsx"
  ]
}
