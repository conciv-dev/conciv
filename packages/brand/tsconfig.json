{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "rootDir": ".",
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/solid/**/*.ts",
    "src/solid/**/*.tsx",
    "src/*.stories.tsx",
    "src/*.mdx",
    "vite.config.ts",
    "tsdown.config.ts",
    "vitest.config.ts",
    "tests/browser/lockup-dom.ts",
    "tests/browser/solid-lockup.browser.test.tsx",
    "tests/browser/solid-lockup-reduced-motion.browser.test.tsx"
  ]
}
