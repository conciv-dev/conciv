{
  "name": "@conciv/brand",
  "version": "0.0.21",
  "private": true,
  "description": "Official conciv brand assets: the crimson chat-bubble robot mark, Geist SemiBold outlined wordmark, favicons, social tiles, and Solid/React logo components.",
  "keywords": [
    "brand",
    "conciv",
    "logo",
    "react",
    "solid-js"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/brand"
  },
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/solid/conciv-lockup.d.ts",
      "import": "./dist/solid.js"
    },
    "./logos.json": "./assets/manifest.json",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "vite build && tsdown -c tsdown.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.react.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@solid-primitives/event-listener": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19",
    "solid-js": "^1.9.13"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
