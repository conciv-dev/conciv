{
  "name": "@conciv/core",
  "version": "0.0.19",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The conciv engine: a framework-free hono + @hono/node-server server exposing the /__pw HTTP surface, with a harness registry seam.",
  "keywords": [
    "ai",
    "conciv",
    "engine",
    "hono",
    "server"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/start.d.ts",
      "import": "./dist/start.js"
    },
    "./start": {
      "types": "./dist/start.d.ts",
      "import": "./dist/start.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./cards": {
      "browser": {
        "types": "./dist/cards.d.ts",
        "default": "./dist/cards.js"
      },
      "import": {
        "types": "./dist/cards.d.ts",
        "default": "./dist/cards.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build && tsc -p tsconfig.cards.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cards.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/contract": "workspace:^",
    "@conciv/db": "workspace:^",
    "@conciv/extension": "workspace:^",
    "@conciv/extension-page": "workspace:^",
    "@conciv/harness": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@conciv/serve": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/tools": "workspace:^",
    "@conciv/ui-kit-chat": "workspace:^",
    "@hono/node-server": "^2.0.8",
    "@jridgewell/trace-mapping": "0.3.31",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/server": "catalog:",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-acp": "0.2.4",
    "@tanstack/ai-code-mode": "catalog:",
    "@tanstack/ai-isolate-node": "catalog:",
    "@tanstack/ai-isolate-quickjs": "catalog:",
    "@tanstack/ai-sandbox": "0.3.0",
    "@tanstack/ai-sandbox-local-process": "^0.2.1",
    "c12": "~3.3.4",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.12.0",
    "jsonc-parser": "^3.3.1",
    "lucide-solid": "^1.18.0",
    "proper-lockfile": "^4.1.2",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@conciv/harness-testkit": "workspace:^",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@orpc/client": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/ai-mcp": "catalog:",
    "@tanstack/ai-sandbox-local-process": "^0.2.1",
    "@types/node": "^22.19.21",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "get-port": "^7.1.0",
    "solid-js": "^1.9.13",
    "storybook": "^10.5.0",
    "storybook-solidjs-vite": "^10.6.0",
    "tsdown": "^0.22.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "unocss": "^66.7.2",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
