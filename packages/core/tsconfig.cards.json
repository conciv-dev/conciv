{
  "extends": "@conciv/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "incremental": false
  },
  "include": ["src/cards.tsx", "src/cards/**/*.ts", "src/cards/**/*.tsx"]
}
