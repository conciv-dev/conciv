{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": [
        "@conciv/client#build",
        "@conciv/backend-defaults#build",
        "@conciv/backend-app-api#build",
        "@conciv/backend-plugin-api#build",
        "@conciv/protocol#build",
        "@conciv/harness#build",
        "@conciv/types#build"
      ]
    },
    "kit-runtime": {
      "dependsOn": ["@conciv/cli#build"]
    },
    "test": {
      "dependsOn": ["build", "kit-runtime"]
    },
    "publint": {
      "dependsOn": ["build"]
    },
    "attw": {
      "dependsOn": ["build"]
    }
  }
}
