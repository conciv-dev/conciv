{
  "name": "@conciv/harness-testkit",
  "version": "0.0.22",
  "description": "Boots the real conciv engine with a scripted fake harness for tests, and talks to it the way the product callers do.",
  "keywords": [
    "conciv",
    "harness",
    "testing",
    "testkit"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/harness-testkit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/harness-engine.d.ts",
      "import": "./dist/harness-engine.js"
    },
    "./run-tests": {
      "types": "./dist/run-tests.d.ts",
      "import": "./dist/run-tests.js"
    },
    "./test-llm": {
      "types": "./dist/test-llm.d.ts",
      "import": "./dist/test-llm.js"
    },
    "./clock": {
      "types": "./dist/clock-steps.d.ts",
      "import": "./dist/clock-steps.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "node dist/run-tests.js",
    "build:types": "tsdown -c tsdown.types.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/plugin-testkit": "workspace:*",
    "@conciv/tsconfig": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@conciv/ai": "workspace:^",
    "@conciv/cli": "workspace:^",
    "@conciv/contract": "workspace:^",
    "@conciv/core": "workspace:^",
    "@conciv/harness": "workspace:^",
    "@conciv/protocol": "workspace:^"
  }
}
