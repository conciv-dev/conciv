{
  "name": "@conciv/plugin-host",
  "version": "0.0.22",
  "description": "Internal to @conciv/core (installed automatically, do not install directly). The engine-side plugin host: replayable plugin state, the hook registry and the tool domain, in Effect.",
  "keywords": [
    "conciv",
    "plugin",
    "plugins"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugin-host"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#fff": {
      "types": "./dist/core/filesystem/fff.node.d.ts",
      "workerd": "./dist/core/filesystem/fff.workerd.js",
      "node": "./dist/core/filesystem/fff.node.js",
      "default": "./dist/core/filesystem/fff.node.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "node node_modules/@conciv/vitest-config/src/run-tests.ts"
  },
  "dependencies": {
    "@conciv/contract": "workspace:^",
    "@conciv/db": "workspace:^",
    "@conciv/plugin": "workspace:^",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@ff-labs/fff-node": "catalog:",
    "@npmcli/arborist": "catalog:",
    "@npmcli/config": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@silvia-odwyer/photon-node": "catalog:",
    "@standard-schema/spec": "catalog:",
    "detect-libc": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fuzzysort": "catalog:",
    "glob": "catalog:",
    "js-yaml": "catalog:",
    "npm-package-arg": "catalog:",
    "pacote": "catalog:",
    "picomatch": "catalog:",
    "which": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/tsconfig": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/npm-package-arg": "catalog:",
    "@types/npmcli__arborist": "catalog:",
    "@types/pacote": "catalog:",
    "@types/which": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "catalog:",
    "@parcel/watcher-darwin-x64": "catalog:",
    "@parcel/watcher-linux-arm64-glibc": "catalog:",
    "@parcel/watcher-linux-arm64-musl": "catalog:",
    "@parcel/watcher-linux-x64-glibc": "catalog:",
    "@parcel/watcher-linux-x64-musl": "catalog:",
    "@parcel/watcher-win32-arm64": "catalog:",
    "@parcel/watcher-win32-x64": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
