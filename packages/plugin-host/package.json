{
  "name": "@conciv/plugin-host",
  "version": "0.0.22",
  "description": "Internal to @conciv/core (installed automatically, do not install directly). The engine-side plugin host: opencode's replayable state, hook registry and tool domain, in Effect.",
  "keywords": [
    "conciv",
    "plugin",
    "plugins"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/plugin-host"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen-migrations": "node src/scripts/gen-migrations.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/db": "workspace:^",
    "@conciv/plugin": "workspace:^",
    "@effect/sql-sqlite-node": "catalog:",
    "@npmcli/arborist": "catalog:",
    "@npmcli/config": "catalog:",
    "@parcel/watcher": "catalog:",
    "@standard-schema/spec": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "glob": "catalog:",
    "npm-package-arg": "catalog:",
    "pacote": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/protocol": "workspace:*",
    "@conciv/tsconfig": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "@types/npm-package-arg": "catalog:",
    "@types/npmcli__arborist": "catalog:",
    "@types/pacote": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "catalog:",
    "@parcel/watcher-darwin-x64": "catalog:",
    "@parcel/watcher-linux-arm64-glibc": "catalog:",
    "@parcel/watcher-linux-arm64-musl": "catalog:",
    "@parcel/watcher-linux-x64-glibc": "catalog:",
    "@parcel/watcher-linux-x64-musl": "catalog:",
    "@parcel/watcher-win32-arm64": "catalog:",
    "@parcel/watcher-win32-x64": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
