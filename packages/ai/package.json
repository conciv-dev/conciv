{
  "name": "@conciv/ai",
  "version": "0.0.23",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The chat primitives conciv is built from: messages, events, tools, usage, the CLI text adapters, the server primitives and testkits.",
  "keywords": [
    "ag-ui",
    "ai",
    "conciv"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/ai"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./testkit": {
      "types": "./dist/testkit.d.ts",
      "import": "./dist/testkit.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/db": "workspace:^",
    "@conciv/protocol": "workspace:^",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-acp": "catalog:",
    "@tanstack/ai-claude-code": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/ai-code-mode": "catalog:",
    "@tanstack/ai-codex": "catalog:",
    "@tanstack/ai-event-client": "catalog:",
    "@tanstack/ai-isolate-quickjs": "catalog:",
    "@tanstack/ai-mcp": "catalog:",
    "@tanstack/ai-opencode": "catalog:",
    "@tanstack/ai-persistence": "catalog:",
    "@tanstack/ai-sandbox": "catalog:",
    "@tanstack/ai-sandbox-local-process": "catalog:",
    "@tanstack/ai-solid": "catalog:",
    "@tanstack/store": "catalog:",
    "drizzle-orm": "catalog:",
    "piscina": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/tsconfig": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxc-parser": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@tanstack/ai-isolate-node": "catalog:"
  }
}
