{
  "name": "@conciv/session-observer",
  "version": "0.0.15",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). Session observation types plus the pure presence state machine, attribution rules and send policy for conciv harness sessions.",
  "keywords": [
    "conciv",
    "observer",
    "presence",
    "session",
    "transcript"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/session-observer"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./machine": {
      "types": "./dist/machine.d.ts",
      "import": "./dist/machine.js"
    },
    "./observer": {
      "types": "./dist/observer.d.ts",
      "import": "./dist/observer.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/protocol": "workspace:^",
    "@tanstack/ai": "^0.41.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^4.1.8",
    "tsdown": "^0.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
