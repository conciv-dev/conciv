{
  "name": "@conciv/ui-kit-chat",
  "version": "0.0.19",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). A clean-room SolidJS implementation of the assistant-ui chat API: headless compound primitives (Thread/Message/Composer/ActionBar/…) plus a neutral, themeable styled set, bound to the canonical @tanstack/ai-client data model. Every component is viewable in Storybook against the real useChat behind a fake connection.",
  "keywords": [
    "ai-chat",
    "assistant-ui",
    "conciv",
    "solid-js",
    "tanstack-ai",
    "ui-kit"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/ui-kit-chat"
  },
  "files": [
    "dist",
    "src/theme/tokens.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./theme/tokens.css": "./src/theme/tokens.css",
    "./theme/fonts": {
      "types": "./dist/theme/fonts.d.ts",
      "import": "./dist/theme/fonts.js"
    },
    "./theme/code-theme": {
      "types": "./dist/theme/code-theme.d.ts",
      "import": "./dist/theme/code-theme.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints theme/tokens.css"
  },
  "dependencies": {
    "@ark-ui/solid": "catalog:",
    "@chenglou/pretext": "0.0.8",
    "@conciv/protocol": "workspace:^",
    "@conciv/solid-diffs": "workspace:^",
    "@conciv/solid-streamdown": "workspace:^",
    "@conciv/storage-history": "workspace:^",
    "@conciv/ui-kit-system": "workspace:^",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.2.9",
    "@shikijs/langs-precompiled": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/keyed": "^1.5.3",
    "@solid-primitives/media": "^2.3.6",
    "@solid-primitives/resize-observer": "^2.2.0",
    "@solid-primitives/timer": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/pacer": "catalog:",
    "@tanstack/solid-virtual": "catalog:",
    "class-variance-authority": "catalog:",
    "es-toolkit": "catalog:",
    "lucide-solid": "catalog:",
    "mermaid": "catalog:",
    "rrweb-snapshot": "catalog:",
    "shiki": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-solid": "catalog:",
    "@types/node": "catalog:",
    "@unocss/postcss": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
