{
  "name": "@conciv/session-presence",
  "version": "0.0.15",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). Pure session presence state machine plus transcript file watch and transcript mirror for conciv harness sessions.",
  "keywords": [
    "conciv",
    "presence",
    "session",
    "transcript"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/session-presence"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./presence": {
      "types": "./dist/presence.d.ts",
      "import": "./dist/presence.js"
    },
    "./transcript-watch": {
      "types": "./dist/transcript-watch.d.ts",
      "import": "./dist/transcript-watch.js"
    },
    "./transcript-mirror": {
      "types": "./dist/transcript-mirror.d.ts",
      "import": "./dist/transcript-mirror.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@conciv/protocol": "workspace:*"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^4.1.8",
    "tsdown": "^0.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
