{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "incremental": false
  },
  "include": ["src/core/**/*.ts", "src/solid/**/*.ts", "src/solid/**/*.tsx"]
}
