{
  "name": "@conciv/mascot",
  "version": "0.0.20",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The conciv robot mascot: a framework-free GSAP mascot service, Solid and React compound components, and sixteen antenna-tip effects.",
  "keywords": [
    "conciv",
    "mascot"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/mascot"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/core/path.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "conciv-source": "./src/core/index.ts",
      "import": "./dist/core/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "conciv-source": "./src/solid/index.ts",
      "solid": "./dist/solid/index.jsx",
      "import": "./dist/solid/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./effects/binary": {
      "types": "./dist/core/effects/binary.d.ts",
      "conciv-source": "./src/core/effects/binary.ts",
      "import": "./dist/core/effects/binary.js"
    },
    "./effects/matrix": {
      "types": "./dist/core/effects/matrix.d.ts",
      "conciv-source": "./src/core/effects/matrix.ts",
      "import": "./dist/core/effects/matrix.js"
    },
    "./effects/thought-cloud": {
      "types": "./dist/core/effects/thought-cloud.d.ts",
      "conciv-source": "./src/core/effects/thought-cloud.ts",
      "import": "./dist/core/effects/thought-cloud.js"
    },
    "./effects/pixel-bubbles": {
      "types": "./dist/core/effects/pixel-bubbles.d.ts",
      "conciv-source": "./src/core/effects/pixel-bubbles.ts",
      "import": "./dist/core/effects/pixel-bubbles.js"
    },
    "./effects/signal-rings": {
      "types": "./dist/core/effects/signal-rings.d.ts",
      "conciv-source": "./src/core/effects/signal-rings.ts",
      "import": "./dist/core/effects/signal-rings.js"
    },
    "./effects/speech-bubble": {
      "types": "./dist/core/effects/speech-bubble.d.ts",
      "conciv-source": "./src/core/effects/speech-bubble.ts",
      "import": "./dist/core/effects/speech-bubble.js"
    },
    "./effects/steam": {
      "types": "./dist/core/effects/steam.d.ts",
      "conciv-source": "./src/core/effects/steam.ts",
      "import": "./dist/core/effects/steam.js"
    },
    "./effects/spark": {
      "types": "./dist/core/effects/spark.d.ts",
      "conciv-source": "./src/core/effects/spark.ts",
      "import": "./dist/core/effects/spark.js"
    },
    "./effects/spark-burst": {
      "types": "./dist/core/effects/spark-burst.d.ts",
      "conciv-source": "./src/core/effects/spark-burst.ts",
      "import": "./dist/core/effects/spark-burst.js"
    },
    "./effects/spark-fountain": {
      "types": "./dist/core/effects/spark-fountain.d.ts",
      "conciv-source": "./src/core/effects/spark-fountain.ts",
      "import": "./dist/core/effects/spark-fountain.js"
    },
    "./effects/satellite": {
      "types": "./dist/core/effects/satellite.d.ts",
      "conciv-source": "./src/core/effects/satellite.ts",
      "import": "./dist/core/effects/satellite.js"
    },
    "./effects/led-cone": {
      "types": "./dist/core/effects/led-cone.d.ts",
      "conciv-source": "./src/core/effects/led-cone.ts",
      "import": "./dist/core/effects/led-cone.js"
    },
    "./effects/tick-ring": {
      "types": "./dist/core/effects/tick-ring.d.ts",
      "conciv-source": "./src/core/effects/tick-ring.ts",
      "import": "./dist/core/effects/tick-ring.js"
    },
    "./effects/signal-bars": {
      "types": "./dist/core/effects/signal-bars.d.ts",
      "conciv-source": "./src/core/effects/signal-bars.ts",
      "import": "./dist/core/effects/signal-bars.js"
    },
    "./effects/heart": {
      "types": "./dist/core/effects/heart.d.ts",
      "conciv-source": "./src/core/effects/heart.ts",
      "import": "./dist/core/effects/heart.js"
    },
    "./effects/notes": {
      "types": "./dist/core/effects/notes.d.ts",
      "conciv-source": "./src/core/effects/notes.ts",
      "import": "./dist/core/effects/notes.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.solid-source.config.ts && tsdown --config tsdown.react.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/react/tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests && playwright test",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "gsap": "catalog:"
  },
  "devDependencies": {
    "@conciv/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "solid-js": ">=1.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
