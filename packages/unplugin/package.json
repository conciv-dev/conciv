{
  "name": "@conciv/unplugin",
  "version": "0.0.22",
  "description": "Internal to @conciv/it (installed automatically, do not install directly). The conciv dev agent as an unplugin: vite (full: viteBridge + widget middleware + boot), webpack/rspack (boot the engine and add the widget entry in dev builds), rollup/esbuild (build-only no-ops). One factory, per-bundler subpath entries.",
  "keywords": [
    "conciv",
    "esbuild",
    "nextjs",
    "rollup",
    "rspack",
    "webpack"
  ],
  "homepage": "https://conciv.dev",
  "bugs": "https://github.com/conciv-dev/conciv/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git",
    "directory": "packages/unplugin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/unplugin.d.ts",
      "import": "./dist/unplugin.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "edge-light": "./dist/nextjs-edge.js",
      "import": "./dist/nextjs.js",
      "default": "./dist/nextjs.js"
    },
    "./vite-bridge": {
      "types": "./dist/core/vite-bridge.d.ts",
      "import": "./dist/core/vite-bridge.js"
    },
    "./nextjs/widget": {
      "types": "./dist/nextjs-widget.d.ts",
      "import": "./dist/nextjs-widget.js",
      "default": "./dist/nextjs-widget.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.types.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@conciv/app": "workspace:^",
    "@conciv/backend": "workspace:^",
    "@conciv/backend-defaults": "workspace:^",
    "@conciv/cli": "workspace:^",
    "@conciv/errors": "workspace:*",
    "@conciv/types": "workspace:^",
    "@orpc/server": "catalog:",
    "@tanstack/devtools-bundler-core": "catalog:",
    "evlog": "catalog:",
    "get-port": "catalog:",
    "launch-editor": "^2.14.2",
    "unplugin": "^3.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conciv/client": "workspace:^",
    "@conciv/protocol": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@rspack/core": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/devtools": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webpack": "catalog:"
  },
  "peerDependencies": {
    "next": "^15.3.0 || ^16.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
