  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/*.d.ts",
    "**/*.generated.ts",
    "packages/extensions/design/**",
    "apps/examples/**",
    "native/swift/**",
    "e2e/astro/**",
    "e2e/nextjs/**",
    "e2e/solid-start/**",
    "e2e/svelte/**",
    "e2e/tanstack-start/**",
    "e2e/vite-react/**",
    "e2e/vite-solid/**",
    "e2e/vite-vanilla/**",
    "**/vitest.config.ts",
    "packages/core/vite.config.ts",
    "packages/tools/vite.config.ts",
    "**/*.stories.tsx",
    "**/*.fixtures.ts",
    "**/*.fixtures.tsx"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "session-facade",
        "patterns": ["packages/core/src/runtime/**", "packages/core/src/runtime.ts"]
      },
      {
        "name": "core-shared-leaf",
        "patterns": ["packages/core/src/lib/debug.ts"]
      },
      {
        "name": "core-tests",
        "patterns": ["packages/core/src/**/*.test.ts", "packages/core/test/**"]
      },
      {
        "name": "core-callers",
        "patterns": ["packages/core/src/**"]
      }
    ],
    "rules": [
      {"from": "core-tests", "allow": ["core-callers", "session-facade", "core-shared-leaf"]},
      {
        "from": "core-callers",
        "allow": ["session-facade", "core-shared-leaf"]
      }
    ],
    "calls": {
      "forbidden": [
        {
          "from": "core-callers",
          "callee": "createRouterClient"
        }
      ]
    }
  },
  "audit": {
    "cacheMaxAgeDays": 1
  },
  "duplicates": {
    "minOccurrences": 3
  },
