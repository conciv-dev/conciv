{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/*.d.ts",
    "**/*.generated.ts",
    "packages/aidx/**",
    "packages/contract/test/helpers/fake-native-socket.ts",
    "packages/extensions/tanstack/test/fixtures/**",
    "packages/extensions/design/test/fixtures/**",
    "packages/oxlint-plugin/test/fixtures/**",
    "packages/cli/test/fixtures/**",
    "packages/unplugin/test/fixtures/extension/**",
    "apps/examples/**",
    "native/swift/**",
    "docs/assets/page-session-card-spike/**",
    "e2e/astro/**",
    "e2e/nextjs/**",
    "e2e/solid-start/**",
    "e2e/svelte/**",
    "e2e/tanstack-start/**",
    "e2e/vite-react/**",
    "e2e/vite-solid/**",
    "e2e/vite-vanilla/**",
    "**/vitest.config.ts",
    "packages/core/vite.config.ts",
    "packages/extensions/page/vite.config.ts",
    "packages/tools/vite.config.ts",
    "**/*.stories.tsx",
    "**/*.test-d.ts",
    "**/*.fixtures.ts",
    "**/*.fixtures.tsx"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "session-facade",
        "patterns": ["packages/core/src/runtime/**", "packages/core/src/runtime.ts"]
      },
      {
        "name": "core-primitives",
        "patterns": ["packages/core/src/page/page-bus.ts", "packages/core/src/tool-registry.ts"]
      },
      {
        "name": "core-shared-leaf",
        "patterns": ["packages/core/src/lib/debug.ts", "packages/core/src/command-policy.ts"]
      },
      {
        "name": "core-callers",
        "patterns": ["packages/core/src/**"]
      },
      {
        "name": "extension-servers",
        "patterns": [
          "packages/extensions/*/src/server.ts",
          "packages/extensions/*/src/server/**/*.ts",
          "packages/extensions/*/src/server/**/*.tsx"
        ]
      }
    ],
    "rules": [
      {
        "from": "core-callers",
        "allow": ["session-facade", "extension-servers", "core-shared-leaf"],
        "allowTypeOnly": ["core-primitives"]
      },
      {
        "from": "core-primitives",
        "allow": ["session-facade", "core-shared-leaf"],
        "allowTypeOnly": ["core-callers"]
      }
    ],
    "calls": {
      "forbidden": [
        {
          "from": "core-callers",
          "callee": "createRouterClient"
        },
        {
          "from": "extension-servers",
          "callee": "createRouterClient"
        }
      ]
    }
  },
  "duplicates": {
    "minOccurrences": 3
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCrap": 30,
    "thresholdOverrides": [
      {
        "files": ["packages/plugin-host/src/**"],
        "maxCognitive": 18,
        "maxCrap": 32,
        "reason": "copied from opencode: the copy keeps opencode's shape"
      }
    ]
  },
  "rules": {
    "unused-exports": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "circular-dependencies": "warn"
  },
  "ignoreDependencies": [
    "@conciv/extension-tanstack",
    "@agentclientprotocol/sdk",
    "@opencode-ai/sdk",
    "@tanstack/ai-mcp",
    "@tanstack/ai-event-client",
    "@tanstack/store",
    "collections",
    "@conciv/app-extensions",
    "conciv",
    "@oxlint/plugins",
    "@ark-ui/solid",
    "@tanstack/solid-virtual",
    "@tiptap/core",
    "@tiptap/extension-document",
    "@tiptap/extension-hard-break",
    "@tiptap/extension-mention",
    "@tiptap/extension-paragraph",
    "@tiptap/extension-text",
    "@tiptap/pm",
    "lucide-solid",
    "marked",
    "rehype-harden",
    "rehype-raw",
    "rehype-sanitize",
    "remark-gfm",
    "remark-parse",
    "remark-rehype",
    "remend",
    "unified",
    "unist-util-visit-parents",
    "@shikijs/langs-precompiled",
    "@conciv/brand",
    "@conciv/client",
    "@conciv/embed",
    "@conciv/extension-compiler",
    "@conciv/extension-page",
    "@conciv/extension-try-it",
    "@conciv/extension-whiteboard",
    "@conciv/grab",
    "@conciv/mascot",
    "@conciv/skills",
    "@conciv/solid-diffs",
    "@conciv/solid-streamdown",
    "@conciv/ui-kit-chat",
    "@conciv/ui-kit-chat-tools",
    "@conciv/ui-kit-system",
    "@conciv/ui-kit-tap",
    "bippy",
    "react-grab",
    "@solidjs/testing-library",
    "cytoscape"
  ],
  "ignoreUnresolvedImports": ["collections/*"],
  "publicPackages": [
    "@conciv/harness-init",
    "@conciv/core",
    "@conciv/embed",
    "@conciv/extension",
    "@conciv/extension-test-runner",
    "@conciv/extension-whiteboard",
    "@conciv/grab",
    "@conciv/harness",
    "@conciv/it",
    "@conciv/mascot",
    "@conciv/mascot-react",
    "@conciv/unplugin",
    "@conciv/plugin",
    "@conciv/plugin-host",
    "@conciv/preact",
    "@conciv/protocol",
    "@conciv/react",
    "@conciv/solid",
    "@conciv/solid-diffs",
    "@conciv/solid-streamdown",
    "@conciv/tools",
    "@conciv/ui-kit-chat",
    "@conciv/ui-kit-chat-tools",
    "@conciv/ui-kit-system",
    "@conciv/ui-kit-tap",
    "@conciv/chat"
  ],
  "ignoreExports": [
    {
      "file": "apps/site/src/components/ui/**",
      "exports": ["*"]
    },
    {
      "file": "packages/ui-kit-chat/src/styled/**",
      "exports": ["*"]
    },
    {
      "file": "packages/plugin/src/**",
      "exports": ["Info", "Ref", "define", "Cleanup", "Id", "Name"]
    },
    {
      "file": "packages/plugin-host/src/**",
      "exports": ["ID", "Interface", "Options", "Service", "Tool", "layer"]
    },
    {
      "file": "packages/ui-kit-chat/src/tools/primitives/tool-fallback.tsx",
      "exports": ["*"]
    },
    {
      "file": "packages/ui-kit-chat/src/tools/styled/tool-fallback.tsx",
      "exports": ["*"]
    }
  ],
  "entry": [
    "packages/plugin-host/src/core/database/**",
    "packages/plugin-host/src/core/location.ts",
    "packages/plugin-host/src/schema/event.ts",
    "packages/brand-react/src/conciv-lockup.tsx",
    "packages/brand/src/brand-guidelines.mdx",
    "packages/ui-kit-chat/src/tools.tsx",
    "packages/extension-testkit/src/host/host-entry.tsx",
    "packages/embed/src/native-entry.ts",
    "packages/extensions/design/src/xray/entry.tsx",
    "packages/extensions/tanstack/test/host/main.tsx",
    "packages/extensions/try-it/test/fixture/connect-pane-fixture.tsx",
    "e2e/harnesses/vite.*.config.ts",
    "packages/db/drizzle-home.config.ts",
    "apps/conciv/test/commands/core-control.ts",
    "apps/conciv/test/commands/core-testkit.ts"
  ],
  "framework": [
    {
      "name": "storybook-config-dir",
      "detection": {
        "type": "fileExists",
        "pattern": "apps/storybook/src/storybook/main.ts"
      },
      "entryPoints": ["apps/storybook/src/storybook/main.ts", "apps/storybook/src/storybook/preview.tsx"],
      "toolingDependencies": [
        "storybook",
        "storybook-solidjs-vite",
        "@chromatic-com/storybook",
        "@storybook/addon-a11y",
        "@storybook/addon-docs",
        "@storybook/addon-themes",
        "@storybook/addon-vitest"
      ]
    }
  ]
}
