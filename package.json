{
  "name": "@conciv/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "An embeddable AI dev agent for your running app: chat, page control, and live tests, injected into the page via a Vite plugin.",
  "homepage": "https://conciv.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciv-dev/conciv.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "node -e \"process.exit(process.env.CI || process.env.GIT_INDEX_FILE ? 0 : 1)\" || prek install",
    "dev": "turbo run dev --filter=tanstack-start-example",
    "dev:watch": "turbo watch dev --filter=@conciv/app",
    "dev:site": "turbo run dev --filter=site",
    "storybook": "turbo run storybook --filter=conciv-storybook",
    "build": "turbo run build",
    "build:affected": "TURBO_SCM_BASE=origin/main turbo run build --affected --filter=!@conciv/extension-design",
    "test": "turbo run test",
    "test:affected": "TURBO_SCM_BASE=origin/main turbo run test --affected --filter=!@conciv/extension-design",
    "e2e": "turbo run test:e2e --continue",
    "typecheck": "turbo run typecheck",
    "typecheck:affected": "TURBO_SCM_BASE=origin/main turbo run typecheck --affected --filter=!@conciv/extension-design",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "changeset": "changeset",
    "release:version": "conciv-publish version",
    "release:check": "conciv-publish check",
    "release": "conciv-publish release",
    "release:snapshot": "conciv-publish snapshot",
    "release:sync": "conciv-publish sync"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@conciv/bundle-size": "workspace:*",
    "@conciv/publish": "workspace:*",
    "@conciv/skills": "workspace:*",
    "@conciv/uno-preset": "workspace:*",
    "@conciv/vitest-config": "workspace:*",
    "@j178/prek": "^0.5.7",
    "@oxlint/plugins": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-plugin": "66.13.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "fallow": "3.36.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "intent": {
    "skills": [
      "workspace:@conciv/client",
      "workspace:@conciv/skills",
      "@tanstack/ai",
      "@tanstack/ai-sandbox",
      "@tanstack/db",
      "@tanstack/devtools",
      "@tanstack/devtools-event-client",
      "@tanstack/devtools-vite",
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/solid-db",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/virtual-file-routes",
      "dotenv",
      "drizzle-kit",
      "fallow"
    ]
  }
}
