{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fallow-gate.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/turbo-filter-gate.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "FALLOW_AUDIT_BASE": "origin/main",
    "NODE_DISABLE_COMPILE_CACHE": "1"
  },
  "enabledPlugins": {
    "fallow@fallow-skills": true
  }
}
